{
 "format": 1,
 "app": {
  "name": "money",
  "title": "Wayland Money",
  "version": "1.0",
  "startForm": "HomeForm"
 },
 "database": {
  "driver": "sqlite",
  "file": "money.db"
 },
 "tables": [
  {
   "name": "Accounts",
   "label": "Accounts",
   "fields": [
    {
     "name": "Name",
     "type": "text",
     "required": true,
     "unique": true,
     "maxLength": 60
    },
    {
     "name": "Type",
     "type": "choice",
     "choices": [
      "Checking",
      "Savings",
      "Credit Card",
      "Cash",
      "Investment",
      "Retirement",
      "Loan",
      "Asset",
      "Liability"
     ],
     "default": "Checking",
     "required": true
    },
    {
     "name": "Institution",
     "type": "text",
     "maxLength": 60
    },
    {
     "name": "AccountNumber",
     "type": "text",
     "label": "Account Number",
     "maxLength": 40
    },
    {
     "name": "OpeningBalance",
     "type": "currency",
     "label": "Opening Balance",
     "default": "0"
    },
    {
     "name": "OpeningDate",
     "type": "date",
     "label": "Opening Date",
     "default": "today"
    },
    {
     "name": "CreditLimit",
     "type": "currency",
     "label": "Credit Limit",
     "validator": "not_negative"
    },
    {
     "name": "InterestRate",
     "type": "decimal",
     "label": "Interest Rate",
     "decimals": 3,
     "validator": "percentage"
    },
    {
     "name": "Closed",
     "type": "boolean"
    },
    {
     "name": "SchwabHash",
     "type": "text",
     "label": "Schwab Link"
    },
    {
     "name": "LastSync",
     "type": "datetime",
     "label": "Last Download"
    },
    {
     "name": "Notes",
     "type": "memo"
    }
   ]
  },
  {
   "name": "Categories",
   "label": "Categories",
   "fields": [
    {
     "name": "Name",
     "type": "text",
     "required": true,
     "unique": true,
     "maxLength": 60
    },
    {
     "name": "Kind",
     "type": "choice",
     "choices": [
      "Expense",
      "Income"
     ],
     "default": "Expense",
     "required": true
    },
    {
     "name": "TaxRelated",
     "type": "boolean",
     "label": "Tax-related"
    },
    {
     "name": "Notes",
     "type": "text"
    }
   ]
  },
  {
   "name": "Payees",
   "label": "Payees",
   "fields": [
    {
     "name": "Name",
     "type": "text",
     "required": true,
     "unique": true,
     "maxLength": 80
    },
    {
     "name": "Category",
     "type": "lookup",
     "label": "Usual Category",
     "lookupTable": "Categories"
    },
    {
     "name": "Phone",
     "type": "phone"
    },
    {
     "name": "Email",
     "type": "email",
     "label": "E-mail"
    },
    {
     "name": "Website",
     "type": "url"
    },
    {
     "name": "Address",
     "type": "memo"
    },
    {
     "name": "Notes",
     "type": "memo"
    }
   ]
  },
  {
   "name": "Securities",
   "label": "Securities",
   "fields": [
    {
     "name": "Symbol",
     "type": "text",
     "required": true,
     "unique": true,
     "maxLength": 32,
     "pattern": "[A-Z0-9 ./$-]+",
     "message": "A symbol is capitals and digits: AAPL, BRK/B."
    },
    {
     "name": "Company",
     "type": "text",
     "maxLength": 120
    },
    {
     "name": "Type",
     "type": "choice",
     "choices": [
      "Stock",
      "ETF",
      "Mutual Fund",
      "Bond",
      "Option",
      "Money Market",
      "Other"
     ],
     "default": "Stock",
     "required": true
    },
    {
     "name": "LastPrice",
     "type": "decimal",
     "label": "Last Price",
     "decimals": 4,
     "validator": "not_negative"
    },
    {
     "name": "Change",
     "type": "decimal",
     "decimals": 4
    },
    {
     "name": "ChangePercent",
     "type": "decimal",
     "label": "Change %",
     "decimals": 2
    },
    {
     "name": "PriceTime",
     "type": "datetime",
     "label": "Price As Of"
    },
    {
     "name": "Watch",
     "type": "boolean",
     "label": "On Watch List"
    }
   ]
  },
  {
   "name": "Transactions",
   "label": "Transactions",
   "fields": [
    {
     "name": "Account",
     "type": "lookup",
     "lookupTable": "Accounts",
     "required": true
    },
    {
     "name": "Date",
     "type": "date",
     "required": true,
     "default": "today"
    },
    {
     "name": "Number",
     "type": "text",
     "label": "Num",
     "maxLength": 12
    },
    {
     "name": "Payee",
     "type": "lookup",
     "lookupTable": "Payees"
    },
    {
     "name": "Category",
     "type": "lookup",
     "lookupTable": "Categories"
    },
    {
     "name": "Memo",
     "type": "text",
     "maxLength": 120
    },
    {
     "name": "Amount",
     "type": "currency",
     "required": true,
     "validator": "expression",
     "rule": "value !== 0 || record.Action",
     "message": "Amount can't be 0."
    },
    {
     "name": "Cleared",
     "type": "choice",
     "label": "Status",
     "choices": [
      "Unreconciled",
      "Cleared",
      "Reconciled"
     ],
     "default": "Unreconciled"
    },
    {
     "name": "TransferAccount",
     "type": "lookup",
     "label": "Transfer Account",
     "lookupTable": "Accounts",
     "validator": "different_from",
     "validatorArg": "Account",
     "message": "A transfer goes to another account."
    },
    {
     "name": "TransferId",
     "type": "integer",
     "label": "Transfer's Other Half"
    },
    {
     "name": "IsSplit",
     "type": "boolean",
     "label": "Split"
    },
    {
     "name": "Action",
     "type": "choice",
     "choices": [
      "Buy",
      "Sell",
      "Dividend",
      "Interest",
      "Reinvest",
      "Add Shares",
      "Remove Shares",
      "Fee"
     ]
    },
    {
     "name": "Security",
     "type": "lookup",
     "lookupTable": "Securities",
     "validator": "only_if",
     "validatorArg": "Action"
    },
    {
     "name": "Quantity",
     "type": "decimal",
     "label": "Shares",
     "decimals": 4,
     "validator": "not_negative"
    },
    {
     "name": "Price",
     "type": "decimal",
     "decimals": 4,
     "validator": "not_negative"
    },
    {
     "name": "Commission",
     "type": "currency",
     "validator": "not_negative"
    },
    {
     "name": "Source",
     "type": "choice",
     "choices": [
      "Manual",
      "Schwab",
      "Bill"
     ],
     "default": "Manual"
    },
    {
     "name": "SchwabId",
     "type": "text",
     "label": "Schwab Id",
     "unique": true
    }
   ]
  },
  {
   "name": "Splits",
   "label": "Splits",
   "fields": [
    {
     "name": "Transaction",
     "type": "lookup",
     "lookupTable": "Transactions",
     "required": true
    },
    {
     "name": "Category",
     "type": "lookup",
     "lookupTable": "Categories",
     "required": true
    },
    {
     "name": "Memo",
     "type": "text",
     "maxLength": 120
    },
    {
     "name": "Amount",
     "type": "currency",
     "required": true,
     "validator": "not_zero"
    }
   ]
  },
  {
   "name": "Bills",
   "label": "Bills and Deposits",
   "fields": [
    {
     "name": "Name",
     "type": "text",
     "required": true,
     "maxLength": 80
    },
    {
     "name": "Kind",
     "type": "choice",
     "choices": [
      "Bill",
      "Deposit",
      "Transfer"
     ],
     "default": "Bill",
     "required": true
    },
    {
     "name": "Account",
     "type": "lookup",
     "lookupTable": "Accounts",
     "required": true
    },
    {
     "name": "ToAccount",
     "type": "lookup",
     "label": "To Account",
     "lookupTable": "Accounts",
     "validator": "different_from",
     "validatorArg": "Account",
     "message": "A transfer goes to another account."
    },
    {
     "name": "Payee",
     "type": "lookup",
     "lookupTable": "Payees"
    },
    {
     "name": "Category",
     "type": "lookup",
     "lookupTable": "Categories"
    },
    {
     "name": "Amount",
     "type": "currency",
     "required": true,
     "validator": "positive"
    },
    {
     "name": "Frequency",
     "type": "choice",
     "choices": [
      "Once",
      "Weekly",
      "Every two weeks",
      "Twice a month",
      "Monthly",
      "Every three months",
      "Every six months",
      "Yearly"
     ],
     "default": "Monthly",
     "required": true
    },
    {
     "name": "NextDue",
     "type": "date",
     "label": "Next Due",
     "required": true,
     "default": "today"
    },
    {
     "name": "EndDate",
     "type": "date",
     "label": "Ends",
     "validator": "on_or_after_field",
     "validatorArg": "NextDue"
    },
    {
     "name": "RemindDays",
     "type": "integer",
     "label": "Remind Days",
     "min": 0,
     "max": 60,
     "default": "7"
    },
    {
     "name": "AutoEnter",
     "type": "boolean",
     "label": "Enter By Itself"
    },
    {
     "name": "Active",
     "type": "boolean",
     "default": "yes"
    },
    {
     "name": "Memo",
     "type": "text",
     "maxLength": 120
    }
   ]
  },
  {
   "name": "Budgets",
   "label": "Budgets",
   "fields": [
    {
     "name": "Category",
     "type": "lookup",
     "lookupTable": "Categories",
     "required": true,
     "unique": true
    },
    {
     "name": "Amount",
     "type": "currency",
     "label": "Monthly Amount",
     "required": true,
     "validator": "positive"
    },
    {
     "name": "Notes",
     "type": "text"
    }
   ]
  },
  {
   "name": "Holdings",
   "label": "Holdings",
   "fields": [
    {
     "name": "Account",
     "type": "lookup",
     "lookupTable": "Accounts",
     "required": true
    },
    {
     "name": "Security",
     "type": "lookup",
     "lookupTable": "Securities",
     "required": true
    },
    {
     "name": "Quantity",
     "type": "decimal",
     "label": "Shares",
     "decimals": 4
    },
    {
     "name": "CostBasis",
     "type": "currency",
     "label": "Cost Basis"
    },
    {
     "name": "MarketValue",
     "type": "currency",
     "label": "Market Value"
    },
    {
     "name": "AsOf",
     "type": "datetime",
     "label": "As Of"
    }
   ]
  },
  {
   "name": "Prices",
   "label": "Prices",
   "fields": [
    {
     "name": "Security",
     "type": "lookup",
     "lookupTable": "Securities",
     "required": true
    },
    {
     "name": "Day",
     "type": "date",
     "required": true
    },
    {
     "name": "Open",
     "type": "decimal",
     "decimals": 4
    },
    {
     "name": "High",
     "type": "decimal",
     "decimals": 4,
     "validator": "at_least_field",
     "validatorArg": "Low"
    },
    {
     "name": "Low",
     "type": "decimal",
     "decimals": 4
    },
    {
     "name": "Close",
     "type": "decimal",
     "decimals": 4,
     "required": true
    },
    {
     "name": "Volume",
     "type": "integer",
     "min": 0
    }
   ]
  },
  {
   "name": "WorthHistory",
   "label": "Net Worth History",
   "fields": [
    {
     "name": "Day",
     "type": "date",
     "required": true,
     "unique": true
    },
    {
     "name": "Assets",
     "type": "currency"
    },
    {
     "name": "Liabilities",
     "type": "currency"
    },
    {
     "name": "Worth",
     "type": "currency",
     "label": "Net Worth"
    }
   ]
  },
  {
   "name": "Settings",
   "label": "Settings",
   "fields": [
    {
     "name": "Name",
     "type": "text",
     "required": true,
     "unique": true,
     "maxLength": 40
    },
    {
     "name": "Value",
     "type": "memo"
    }
   ]
  },
  {
   "name": "Listing",
   "label": "Listing (column headings)",
   "fields": [
    {
     "name": "Date",
     "type": "text"
    },
    {
     "name": "Num",
     "type": "text"
    },
    {
     "name": "Payee",
     "type": "text"
    },
    {
     "name": "Category",
     "type": "text"
    },
    {
     "name": "Memo",
     "type": "text"
    },
    {
     "name": "C",
     "type": "text"
    },
    {
     "name": "Account",
     "type": "text"
    },
    {
     "name": "Type",
     "type": "text"
    },
    {
     "name": "Item",
     "type": "text"
    },
    {
     "name": "Symbol",
     "type": "text"
    },
    {
     "name": "Name",
     "type": "text"
    },
    {
     "name": "Payment",
     "type": "currency"
    },
    {
     "name": "Deposit",
     "type": "currency"
    },
    {
     "name": "Balance",
     "type": "currency"
    },
    {
     "name": "Amount",
     "type": "currency"
    },
    {
     "name": "Income",
     "type": "currency"
    },
    {
     "name": "Expenses",
     "type": "currency"
    },
    {
     "name": "Budget",
     "type": "currency"
    },
    {
     "name": "Spent",
     "type": "currency"
    },
    {
     "name": "Left",
     "type": "currency"
    },
    {
     "name": "Shares",
     "type": "currency"
    },
    {
     "name": "Price",
     "type": "currency"
    },
    {
     "name": "Value",
     "type": "currency"
    },
    {
     "name": "Cost",
     "type": "currency"
    },
    {
     "name": "Gain",
     "type": "currency"
    },
    {
     "name": "Percent",
     "type": "currency",
     "label": "Gain %"
    },
    {
     "name": "Principal",
     "type": "currency"
    },
    {
     "name": "Interest",
     "type": "currency"
    }
   ]
  }
 ],
 "forms": [
  {
   "name": "HomeForm",
   "width": 760,
   "height": 560,
   "props": {
    "title": "Wayland Money"
   },
   "controls": [
    {
     "type": "Menu",
     "name": "menu1",
     "x": 0,
     "y": 0,
     "width": 760,
     "height": 20,
     "props": {
      "menus": [
       {
        "text": "&File",
        "name": "fileMenu",
        "items": [
         {
          "text": "&Find Transactions...",
          "name": "fileFind",
          "shortcut": "Ctrl+F",
          "action": "openForm",
          "form": "FindForm"
         },
         {
          "separator": true
         },
         {
          "text": "E&xit",
          "name": "fileExit",
          "action": "quit"
         }
        ]
       },
       {
        "text": "&Accounts",
        "name": "accountsMenu",
        "items": [
         {
          "text": "&Account List...",
          "name": "accountsList",
          "shortcut": "Ctrl+Shift+A",
          "action": "openForm",
          "form": "AccountsForm"
         },
         {
          "text": "Open &Register",
          "name": "accountsRegister",
          "shortcut": "Ctrl+R"
         },
         {
          "text": "&Balance an Account...",
          "name": "accountsBalance"
         },
         {
          "separator": true
         },
         {
          "text": "&Payees...",
          "name": "accountsPayees",
          "action": "openForm",
          "form": "PayeesForm"
         },
         {
          "text": "&Categories...",
          "name": "accountsCategories",
          "action": "openForm",
          "form": "CategoriesForm"
         }
        ]
       },
       {
        "text": "&Bills",
        "name": "billsMenu",
        "items": [
         {
          "text": "&Bills && Deposits...",
          "name": "billsList",
          "shortcut": "Ctrl+B",
          "action": "openForm",
          "form": "BillsForm"
         },
         {
          "text": "B&udget...",
          "name": "billsBudget",
          "action": "openForm",
          "form": "BudgetForm"
         }
        ]
       },
       {
        "text": "&Investing",
        "name": "investMenu",
        "items": [
         {
          "text": "&Portfolio...",
          "name": "investPortfolio",
          "shortcut": "Ctrl+P",
          "action": "openForm",
          "form": "PortfolioForm"
         },
         {
          "text": "Record a &Trade...",
          "name": "investTrade"
         },
         {
          "text": "&Securities && Prices...",
          "name": "investSecurities",
          "action": "openForm",
          "form": "SecuritiesForm"
         }
        ]
       },
       {
        "text": "&Reports",
        "name": "reportsMenu",
        "items": [
         {
          "text": "&Reports && Charts...",
          "name": "reportsList",
          "action": "openForm",
          "form": "ReportsForm"
         },
         {
          "text": "&Loan Planner...",
          "name": "reportsPlanner",
          "action": "openForm",
          "form": "PlannerForm"
         }
        ]
       },
       {
        "text": "&Online",
        "name": "onlineMenu",
        "items": [
         {
          "text": "&Download from Schwab",
          "name": "onlineSync",
          "shortcut": "F9"
         },
         {
          "text": "Schwab &Setup...",
          "name": "onlineSetup",
          "action": "openForm",
          "form": "SchwabForm"
         }
        ]
       },
       {
        "text": "&Help",
        "name": "helpMenu",
        "items": [
         {
          "text": "Ask the &Advisor...",
          "name": "helpAdvisor",
          "shortcut": "F2",
          "action": "openForm",
          "form": "AdvisorForm"
         },
         {
          "separator": true
         },
         {
          "text": "&About Wayland Money",
          "name": "helpAbout",
          "action": "openForm",
          "form": "AboutForm"
         }
        ]
       }
      ]
     },
     "events": {
      "itemClicked": "if (menu1.item === \"accountsRegister\")\n    openRegister();\nelse if (menu1.item === \"accountsBalance\" && accountGrid.currentId !== null)\n    App.openForm(\"ReconcileForm\", { account: accountGrid.currentId });\nelse if (menu1.item === \"accountsBalance\")\n    form.msgBox(\"Click an account in the list first.\", \"Balance an Account\");\nelse if (menu1.item === \"investTrade\")\n    App.openForm(\"TradeForm\", { account: accountGrid.currentId });\nelse if (menu1.item === \"onlineSync\")\n    App.showForm(\"SchwabForm\").syncAll();"
     }
    },
    {
     "type": "ToolBar",
     "name": "toolBar1",
     "x": 0,
     "y": 20,
     "width": 760,
     "height": 28,
     "props": {
      "buttons": [
       {
        "text": "Accounts",
        "name": "accountsTool",
        "glyph": "▤",
        "toolTip": "The list of accounts",
        "action": "openForm",
        "form": "AccountsForm"
       },
       {
        "text": "Register",
        "name": "registerTool",
        "glyph": "✎",
        "toolTip": "The selected account's register"
       },
       {
        "text": "Find",
        "name": "findTool",
        "glyph": "⌕",
        "toolTip": "Find transactions",
        "action": "openForm",
        "form": "FindForm"
       },
       {
        "separator": true
       },
       {
        "text": "Bills",
        "name": "billsTool",
        "glyph": "✉",
        "toolTip": "Bills and deposits",
        "action": "openForm",
        "form": "BillsForm"
       },
       {
        "text": "Budget",
        "name": "budgetTool",
        "glyph": "◔",
        "toolTip": "The budget",
        "action": "openForm",
        "form": "BudgetForm"
       },
       {
        "separator": true
       },
       {
        "text": "Portfolio",
        "name": "portfolioTool",
        "glyph": "▲",
        "toolTip": "What the investment accounts hold",
        "action": "openForm",
        "form": "PortfolioForm"
       },
       {
        "text": "Reports",
        "name": "reportsTool",
        "glyph": "▥",
        "toolTip": "Reports and charts",
        "action": "openForm",
        "form": "ReportsForm"
       },
       {
        "separator": true
       },
       {
        "text": "Download",
        "name": "syncTool",
        "glyph": "⇩",
        "toolTip": "Download from Schwab (F9)"
       },
       {
        "text": "Advisor",
        "name": "advisorTool",
        "glyph": "✦",
        "toolTip": "Ask the Advisor",
        "action": "openForm",
        "form": "AdvisorForm"
       }
      ]
     },
     "events": {
      "itemClicked": "if (toolBar1.item === \"registerTool\")\n    openRegister();\nelse if (toolBar1.item === \"syncTool\")\n    App.showForm(\"SchwabForm\").syncAll();"
     }
    },
    {
     "type": "Frame",
     "name": "accountsFrame",
     "x": 8,
     "y": 56,
     "width": 372,
     "height": 270,
     "props": {
      "text": "Accounts"
     },
     "events": {}
    },
    {
     "type": "Frame",
     "name": "billsFrame",
     "x": 388,
     "y": 56,
     "width": 364,
     "height": 124,
     "props": {
      "text": "Bills coming up"
     },
     "events": {}
    },
