            },
            "width": 480
        },
        {
            "code": {
                "current": "form.title = form.isNew ? \"New Song\" : \"Song: \" + form.record.Title;\nratingBox.currentIndex = form.record.Rating || 0;\nstatsLabel.text = form.isNew ? \"\" : \"Played \" + (form.record.Plays || 0) + \" times\" + (form.record.Length ? \", \" + form.record.Length : \"\");",
                "general": "// Title, Artist and Album from where the file is. Under a Music folder:\n// Music/artist/album/05-title.mp3 (the folders' names, - and _ as spaces).\n// Elsewhere: \"Artist - Title.mp3\", and the folder it's in as the album.\nfunction words(s) {\n    s = String(s || \"\").replace(/[-_]+/g, \" \").replace(/\\s+/g, \" \").trim();\n    return s.replace(/(^|\\s)(\\S)/g, function (m, sp, c) { return sp + c.toUpperCase(); });\n}\nfunction guess(path) {\n    var clean = String(path).trim().replace(/[?#].*$/, \"\");\n    var web = /^[a-z]+:\\/\\//i.test(clean);\n    var parts = clean.replace(/^[a-z]+:\\/\\/[^\\/]*/i, \"\").split(\"/\").filter(function (p) { return p !== \"\"; });\n    var file = parts.length ? decodeURIComponent(parts[parts.length - 1]) : \"\";\n    var dirs = parts.slice(0, -1);\n    // the file's name, less its extension and one track number (\"05-\", \"05. \", \"05 \")\n    var base = file.replace(/\\.[A-Za-z0-9]{2,5}$/, \"\").replace(/^\\d{1,3}(\\s*[-.]\\s*|\\s+)/, \"\");\n    var artist = \"\", album = \"\", title = \"\";\n    var music = -1;\n    for (var i = 0; i < dirs.length; ++i)\n        if (dirs[i].toLowerCase() === \"music\")\n            music = i;\n    var dash = base.indexOf(\" - \");\n    if (dash > 0) {\n        artist = base.substring(0, dash).trim();\n        title = base.substring(dash + 3).trim();\n    } else {\n        title = base;\n    }\n    if (music >= 0 && !web) {\n        var under = dirs.slice(music + 1);\n        if (under.length >= 1 && dash < 0) {\n            artist = words(under[0]);\n            // \"the-doors-break-on-through\": the artist's name at the front goes\n            if (base.toLowerCase().indexOf(under[0].toLowerCase() + \"-\") === 0)\n                title = base.substring(under[0].length + 1);\n        }\n        if (under.length >= 2)\n            album = under[under.length - 1];\n    } else if (!web && dirs.length >= 1) {\n        album = dirs[dirs.length - 1];\n    }\n    // \"1982-the-number-of-the-beast\": the year goes\n    album = words(album.replace(/^\\d{4}\\s*[-. ]\\s*/, \"\"));\n    // a slug (\"hallowed-be-thy-name\") as words; a name with spaces as it is\n    title = title.indexOf(\" \") < 0 ? words(title) : title.trim();\n    return { Title: title || file, Artist: artist, Album: album, File: String(path).trim() };\n}",
                "load": "if (form.args && form.args.id)\n    form.loadRecord(form.args.id);\nelse {\n    form.newRecord();\n    form.setField(\"Position\", Db.count(\"Tracks\") + 1);\n}",
                "saved": "var p = App.form(\"PlayerForm\");\nif (p)\n    p.reorder();"
            },
            "controls": [
                {
                    "height": 17,
                    "name": "fileLabel",
                    "props": {
