     "y": 360,
     "width": 110,
     "height": 24,
     "props": {
      "text": "Mark Cleared"
     },
     "events": {
      "clicked": "toggle();"
     }
    },
    {
     "type": "Button",
     "name": "finishButton",
     "x": 350,
     "y": 360,
     "width": 96,
     "height": 24,
     "props": {
      "text": "Finish",
      "enabled": false
     },
     "events": {
      "clicked": "var done = 0;\nDb.select(\"Transactions\", { where: { Account: accountId, Cleared: \"Cleared\" } }).forEach(function (t) {\n    Db.update(\"Transactions\", t.id, { Cleared: \"Reconciled\" });\n    done += 1;\n});\nform.msgBox(\"Balanced: \" + done + \" transactions are reconciled.\", \"Balance an Account\", \"info\", [\"OK\"], function () {\n    form.close();\n});"
     }
    },
    {
     "type": "Button",
     "name": "cancelButton",
     "x": 456,
     "y": 360,
     "width": 96,
     "height": 24,
     "props": {
      "text": "Close"
     },
     "events": {
      "clicked": "form.close();"
     }
    },
    {
     "type": "Label",
     "name": "helpLabel",
     "x": 8,
     "y": 394,
     "width": 544,
     "height": 17,
     "props": {
      "text": "Double-click each transaction that's on the statement, until the difference is 0.00."
     },
     "events": {}
    }
   ],
   "code": {
    "general": "readonly property var home: App.form(\"HomeForm\")\nproperty var accountId: null\nproperty real difference: 0\n\n// the transactions not reconciled yet, up to the statement's day\nfunction fill() {\n    var account = Db.get(\"Accounts\", accountId), payees = home.names(\"Payees\");\n    var cleared = account.OpeningBalance || 0, out = [], day = statementPicker.value || home.today();\n    Db.select(\"Transactions\", { where: { Account: accountId }, orderBy: \"Date\" }).forEach(function (t) {\n        if (t.Cleared !== \"Unreconciled\")\n            cleared += t.Amount;\n        if (t.Cleared === \"Reconciled\" || t.Date > day)\n            return;\n        out.push({ id: t.id, Date: home.showDate(t.Date), Num: t.Number || \"\", Payee: payees[t.Payee] || t.Memo || \"\",\n                   C: t.Cleared === \"Cleared\" ? \"C\" : \"\", Payment: t.Amount < 0 ? home.fmt(-t.Amount) : \"\",\n                   Deposit: t.Amount >= 0 ? home.fmt(t.Amount) : \"\" });\n    });\n    var keep = grid.currentIndex;\n    grid.rows = out;\n    grid.currentIndex = Math.min(keep, out.length - 1);\n    var ending = home.parseMoney(endingBox.text);\n    clearedLabel.text = home.fmt(cleared);\n    difference = ending === null ? NaN : Math.round((ending - cleared) * 100) / 100;\n    differenceLabel.text = ending === null ? \"(type the statement's ending balance)\" : home.fmt(difference);\n    differenceLabel.foreColor = difference === 0 ? \"#008000\" : \"#c00000\";\n    finishButton.enabled = difference === 0;\n    form.title = \"Balance \" + account.Name;\n}\n\n// tick or untick the row that's selected\nfunction toggle() {\n    if (grid.currentId === null)\n        return;\n    var t = Db.get(\"Transactions\", grid.currentId);\n    Db.update(\"Transactions\", t.id, { Cleared: t.Cleared === \"Cleared\" ? \"Unreconciled\" : \"Cleared\" });\n    fill();\n}",
    "load": "accountId = form.args.account;\nfill();"
   }
  },
