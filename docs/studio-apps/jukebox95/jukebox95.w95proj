        {
            "code": {
                "general": "\nfunction addAll() {\n    var lines = pathsBox.text.split(/\\r?\\n/);\n    var p = App.form(\"PlayerForm\");\n    if (!p)\n        p = App.openForm(\"PlayerForm\");\n    if (lines.join(\"\").trim() === \"\") {\n        form.msgBox(\"Paste the songs' paths in the box first, one on each line.\", \"Paste Paths\", \"info\");\n        return;\n    }\n    addButton.enabled = false;\n    p.addPaths(lines, function (r) {\n        addButton.enabled = true;\n        pathsBox.text = \"\";\n        form.msgBox(p.said(r), \"Paste Paths\", r.refused.length > 0 ? \"warning\" : \"info\", [\"OK\"], function () {\n            if (r.refused.length === 0)\n                form.close();\n        });\n    });\n}\n"
            },
            "controls": [
                {
                    "height": 17,
                    "name": "helpLabel",
                    "props": {
                        "text": "Paste the songs' paths here, one on each line. A folder's, from a Terminal:"
                    },
                    "type": "Label",
                    "width": 416,
                    "x": 12,
                    "y": 12
