     "width": 80,
     "height": 24,
     "props": {
      "text": "OK",
      "isDefault": true
     },
     "events": {
      "clicked": "form.close();"
     }
    }
   ],
   "code": {
    "load": "versionLabel.text = \"Version \" + App.version;"
   }
  }
 ]
}
