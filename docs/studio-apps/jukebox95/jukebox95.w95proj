                {
                    "events": {
                        "clicked": "var path = fileBox.text, g = guess(path);\nApp.readTags(path, function (t) {\n    form.setField(\"Title\", t.title || g.Title);\n    form.setField(\"Artist\", t.artist || t.albumArtist || g.Artist);\n    form.setField(\"Album\", t.album || g.Album);\n    if (t.duration > 0)\n        form.setField(\"Length\", Math.floor(t.duration / 60000) + \":\" + (\"0\" + Math.floor(t.duration / 1000) % 60).slice(-2));\n    statsLabel.text = t.ok ? \"Read from its tags\" : (App.fileInfo(path).exists ? \"No tags: a guess from its name\" : \"There's no such file\");\n});"
                    },
