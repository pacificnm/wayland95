                },
                {
                    "events": {
                        "clicked": "App.chooseFile({ title: \"Song\", folder: form.record.File ? App.fileInfo(form.record.File).folder : \"~/Music\", filters: [\"Music (*.mp3 *.flac *.ogg *.m4a *.wav *.opus)\", \"All Files (*.*)\"] }, function (path) {\n    if (path !== \"\")\n        form.setField(\"File\", path);\n});"
                    },
                    "height": 21,
                    "name": "browseButton",
                    "props": {
                        "text": "...",
                        "toolTip": "Choose the file"
                    },
                    "type": "Button",
                    "width": 24,
                    "x": 360,
