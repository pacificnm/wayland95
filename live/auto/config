#!/bin/sh
# live-build's settings for the Wayland 95 live ISO (run by `lb config`).
set -e

lb config noauto \
    --distribution trixie \
    --apt-recommends false \
    --archive-areas "main contrib non-free non-free-firmware" \
    --security true \
    --updates true \
    --binary-images iso-hybrid \
    --debian-installer none \
    --firmware-chroot true \
    --memtest none \
    --image-name wayland95-live \
    --iso-application "Wayland 95" \
    --iso-volume "Wayland 95" \
    --iso-publisher "Wayland 95" \
    --bootappend-live "boot=live components quiet splash hostname=wayland95 username=live user-fullname=Live user-default-groups=audio,cdrom,dip,floppy,video,render,input,plugdev,netdev,bluetooth,lpadmin,scanner,sudo" \
    --bootappend-live-failsafe "boot=live components nomodeset nosplash hostname=wayland95 username=live user-fullname=Live user-default-groups=audio,cdrom,dip,floppy,video,render,input,plugdev,netdev,bluetooth,lpadmin,scanner,sudo" \
    "${@}"
