{
    // Run and Debug: the nested desktop under the debugger (C/C++ extension).
    // Programs then open in it with the "Nested: ..." tasks.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug nested desktop",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/wayland95-compositor",
            "args": ["--socket", "win95-test", "--run", "dbus-run-session -- ${workspaceFolder}/build/win95shell"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "Build",
            "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }]
        }
    ]
}
