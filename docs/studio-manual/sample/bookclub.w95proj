{
 "app": {
  "name": "bookclub",
  "startForm": "BooksForm",
  "title": "Book Club",
  "version": "1.0"
 },
 "database": {
  "driver": "sqlite",
  "file": "bookclub.db"
 },
 "format": 1,
 "forms": [
  {
   "code": {
    "general": "// how many stars a rating is\nfunction stars(n) {\n    return n ? \"★★★★★\".substring(0, n) + \"☆☆☆☆☆\".substring(0, 5 - n) : \"\";\n}",
    "current": "if (form.isNew)\n    statusLabel.text = \"A new book: fill it in and press Save.\";\nelse\n    statusLabel.text = form.record.Title + \"  \" + stars(form.record.Rating);",
    "saved": "statusLabel.text = \"Saved \" + form.record.Title + \".\";",
    "validationFailed": "statusLabel.text = \"Not saved: the fields marked in red say why.\";"
   },
   "controls": [
    {
     "type": "Menu",
     "name": "menu1",
     "height": 20,
     "props": {
      "menus": [
       {
        "text": "&File",
        "name": "fileMenu",
        "items": [
         {
          "text": "&New Book",
          "name": "fileNew",
          "shortcut": "Ctrl+N",
          "action": "newRecord"
         },
         {
          "text": "&Save",
          "name": "fileSave",
          "shortcut": "Ctrl+S",
          "action": "save"
         },
         {
          "text": "&Delete",
          "name": "fileDelete",
          "action": "deleteRecord"
         },
         {
          "separator": true
         },
         {
          "text": "&Clear the Form",
          "name": "fileClear"
         },
         {
          "separator": true
         },
         {
          "text": "E&xit",
          "name": "fileExit",
          "action": "quit"
         }
        ]
       },
       {
        "text": "&Go",
        "name": "goMenu",
        "items": [
         {
          "text": "&First",
          "name": "goFirst",
          "action": "first"
         },
         {
          "text": "&Previous",
          "name": "goPrevious",
          "shortcut": "Ctrl+PgUp",
          "action": "previous"
         },
         {
          "text": "&Next",
          "name": "goNext",
          "shortcut": "Ctrl+PgDown",
          "action": "next"
         },
         {
          "text": "&Last",
          "name": "goLast",
          "action": "last"
         }
        ]
       },
       {
        "text": "&Club",
        "name": "clubMenu",
        "items": [
         {
          "text": "&Members...",
          "name": "clubMembers",
          "action": "openForm",
          "form": "MembersForm"
         }
        ]
       },
       {
        "text": "&Help",
        "name": "helpMenu",
        "items": [
         {
          "text": "&About Book Club",
          "name": "helpAbout",
          "action": "openForm",
          "form": "AboutForm"
         }
        ]
       }
      ]
     },
     "events": {
      "itemClicked": "if (menu1.item === \"fileClear\")\n    form.reset();"
     },
     "x": 0,
     "y": 0,
     "width": 644
    },
    {
     "type": "ToolBar",
     "name": "toolBar1",
     "height": 28,
     "props": {
      "buttons": [
       {
        "text": "New",
        "name": "newTool",
        "icon": "new",
        "toolTip": "A new book",
        "action": "newRecord"
       },
       {
        "text": "Save",
        "name": "saveTool",
        "icon": "save",
        "toolTip": "Save the book",
        "action": "save"
       },
       {
        "text": "Delete",
        "name": "deleteTool",
        "icon": "delete",
        "toolTip": "Delete the book",
        "action": "deleteRecord"
       },
       {
        "separator": true
       },
       {
        "text": "",
        "name": "firstTool",
        "icon": "first",
        "toolTip": "The first book",
        "action": "first"
       },
       {
        "text": "",
        "name": "previousTool",
        "icon": "previous",
        "toolTip": "The book before",
        "action": "previous"
       },
       {
        "text": "",
        "name": "nextTool",
        "icon": "next",
        "toolTip": "The next book",
        "action": "next"
       },
       {
        "text": "",
        "name": "lastTool",
        "icon": "last",
        "toolTip": "The last book",
        "action": "last"
       },
       {
        "separator": true
       },
       {
        "text": "Members",
        "name": "membersTool",
        "icon": "people",
        "toolTip": "The club's members",
        "action": "openForm",
        "form": "MembersForm"
       }
      ]
     },
     "events": {},
     "x": 0,
     "y": 20,
     "width": 644
    },
    {
     "events": {},
     "height": 17,
     "name": "titleLabel",
     "props": {
      "text": "Title:",
      "fontBold": true
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 62
    },
    {
     "events": {},
     "height": 21,
     "name": "titleBox",
     "props": {
      "field": "Title"
     },
     "type": "TextBox",
     "width": 180,
     "x": 108,
     "y": 60
    },
    {
     "events": {},
     "height": 17,
     "name": "authorLabel",
     "props": {
      "text": "Author:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 90
    },
    {
     "events": {},
     "height": 21,
     "name": "authorBox",
     "props": {
      "field": "Author"
     },
     "type": "TextBox",
     "width": 180,
     "x": 108,
     "y": 88
    },
    {
     "events": {},
     "height": 17,
     "name": "genreLabel",
     "props": {
      "text": "Genre:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 118
    },
    {
     "events": {},
     "height": 21,
     "name": "genreCombo",
     "props": {
      "field": "Genre"
     },
     "type": "ComboBox",
     "width": 180,
     "x": 108,
     "y": 116
    },
    {
     "events": {},
     "height": 17,
     "name": "readerLabel",
     "props": {
      "text": "Reader:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 146
    },
    {
     "events": {},
     "height": 21,
     "name": "readerCombo",
     "props": {
      "field": "Reader"
     },
     "type": "ComboBox",
     "width": 180,
     "x": 108,
     "y": 144
    },
    {
     "events": {},
     "height": 17,
     "name": "pagesLabel",
     "props": {
      "text": "Pages:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 174
    },
    {
     "events": {},
     "height": 21,
     "name": "pagesBox",
     "props": {
      "field": "Pages"
     },
     "type": "TextBox",
     "width": 180,
     "x": 108,
     "y": 172
    },
    {
     "events": {},
     "height": 17,
     "name": "startedLabel",
     "props": {
      "text": "Started:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 202
    },
    {
     "events": {},
     "height": 21,
     "name": "startedPicker",
     "props": {
      "field": "Started",
      "mode": "Date"
     },
     "type": "DateTimePicker",
     "width": 180,
     "x": 108,
     "y": 200
    },
    {
     "events": {},
     "height": 17,
     "name": "finishedLabel",
     "props": {
      "text": "Finished:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 230
    },
    {
     "events": {},
     "height": 21,
     "name": "finishedPicker",
     "props": {
      "field": "Finished",
      "mode": "Date"
     },
     "type": "DateTimePicker",
     "width": 180,
     "x": 108,
     "y": 228
    },
    {
     "events": {},
     "height": 17,
     "name": "ratingLabel",
     "props": {
      "text": "Rating:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 258
    },
    {
     "events": {},
     "height": 21,
     "name": "ratingBox",
     "props": {
      "field": "Rating"
     },
     "type": "TextBox",
     "width": 180,
     "x": 108,
     "y": 256
    },
    {
     "events": {},
     "height": 17,
     "name": "addedLabel",
     "props": {
      "text": "Added:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 286
    },
    {
     "events": {},
     "height": 21,
     "name": "addedPicker",
     "props": {
      "enabled": false,
      "field": "Added",
      "mode": "Date and Time"
     },
     "type": "DateTimePicker",
     "width": 180,
     "x": 108,
     "y": 284
    },
    {
     "events": {
      "clicked": "form.newRecord();\ntitleBox.forceActiveFocus();"
     },
     "height": 24,
     "name": "newButton",
     "props": {
      "text": "New"
     },
     "type": "Button",
     "width": 84,
     "x": 12,
     "y": 317
    },
    {
     "events": {
      "clicked": "form.save();"
     },
     "height": 24,
     "name": "saveButton",
     "props": {
      "isDefault": true,
      "text": "Save"
     },
     "type": "Button",
     "width": 84,
     "x": 104,
     "y": 317
    },
    {
     "events": {
      "clicked": "if (form.isNew)\n    return;\nform.msgBox(\"Delete this record?\", \"Delete\", \"question\", [\"Yes\", \"No\"], function (answer) {\n    if (answer === 0)\n        form.deleteRecord();\n});"
     },
     "height": 24,
     "name": "deleteButton",
     "props": {
      "text": "Delete"
     },
     "type": "Button",
     "width": 84,
     "x": 196,
     "y": 317
    },
    {
     "events": {},
     "height": 281,
     "name": "grid",
     "props": {},
     "type": "DataGrid",
     "width": 328,
     "x": 304,
     "y": 60
    },
    {
     "type": "Label",
     "name": "statusLabel",
     "x": 12,
     "y": 351,
     "width": 620,
     "height": 21,
     "props": {
      "text": "",
      "borderStyle": "Sunken",
      "backColor": "#ffffe1"
     },
     "events": {}
    }
   ],
   "height": 382,
   "name": "BooksForm",
   "props": {
    "table": "Books",
    "title": "Book Club"
   },
   "width": 644
  },
  {
   "code": {},
   "controls": [
    {
     "events": {},
     "height": 17,
     "name": "nameLabel",
     "props": {
      "text": "Name:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 14
    },
    {
     "events": {},
     "height": 21,
     "name": "nameBox",
     "props": {
      "field": "Name"
     },
     "type": "TextBox",
     "width": 180,
     "x": 108,
     "y": 12
    },
    {
     "events": {},
     "height": 17,
     "name": "emailLabel",
     "props": {
      "text": "E-mail:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 42
    },
    {
     "events": {},
     "height": 21,
     "name": "emailBox",
     "props": {
      "field": "Email"
     },
     "type": "TextBox",
     "width": 180,
     "x": 108,
     "y": 40
    },
    {
     "events": {},
     "height": 17,
     "name": "joinedLabel",
     "props": {
      "text": "Joined:"
     },
     "type": "Label",
     "width": 92,
     "x": 12,
     "y": 70
    },
    {
     "events": {},
     "height": 21,
     "name": "joinedPicker",
     "props": {
      "field": "Joined",
      "mode": "Date"
     },
     "type": "DateTimePicker",
     "width": 180,
     "x": 108,
     "y": 68
    },
    {
     "events": {
      "clicked": "form.newRecord();\nnameBox.forceActiveFocus();"
     },
     "height": 24,
     "name": "newButton",
     "props": {
      "text": "New"
     },
     "type": "Button",
     "width": 84,
     "x": 12,
     "y": 101
    },
    {
     "events": {
      "clicked": "form.save();"
     },
     "height": 24,
     "name": "saveButton",
     "props": {
      "isDefault": true,
      "text": "Save"
     },
     "type": "Button",
     "width": 84,
     "x": 104,
     "y": 101
    },
    {
     "events": {
      "clicked": "if (form.isNew)\n    return;\nform.msgBox(\"Delete this record?\", \"Delete\", \"question\", [\"Yes\", \"No\"], function (answer) {\n    if (answer === 0)\n        form.deleteRecord();\n});"
     },
     "height": 24,
     "name": "deleteButton",
     "props": {
      "text": "Delete"
     },
     "type": "Button",
     "width": 84,
     "x": 196,
     "y": 101
    },
    {
     "events": {},
     "height": 160,
     "name": "grid",
     "props": {},
     "type": "DataGrid",
     "width": 328,
     "x": 304,
     "y": 12
    }
   ],
   "height": 184,
   "name": "MembersForm",
   "props": {
    "table": "Members",
    "title": "Members"
   },
   "width": 644
  },
  {
   "name": "AboutForm",
   "width": 300,
   "height": 130,
   "props": {
    "title": "About Book Club",
    "resizable": false
   },
   "code": {},
   "controls": [
    {
     "type": "Label",
     "name": "aboutLabel",
     "x": 16,
     "y": 16,
     "width": 268,
     "height": 54,
     "props": {
      "text": "Book Club 1.0\nMade in Wayland Studio",
      "alignment": "Center",
      "fontBold": true,
      "fontSize": 13
     },
     "events": {}
    },
    {
     "type": "Button",
     "name": "okButton",
     "x": 110,
     "y": 88,
     "width": 80,
     "height": 24,
     "props": {
      "text": "OK",
      "isDefault": true
     },
     "events": {
      "clicked": "form.close();"
     }
    }
   ]
  }
 ],
 "tables": [
  {
   "fields": [
    {
     "maxLength": 60,
     "name": "Name",
     "required": true,
     "type": "text",
     "unique": true
    },
    {
     "label": "E-mail",
     "name": "Email",
     "type": "email",
     "unique": true
    },
    {
     "default": "today",
     "name": "Joined",
     "type": "date"
    }
   ],
   "label": "Members",
   "name": "Members"
  },
  {
   "fields": [
    {
     "maxLength": 120,
     "name": "Title",
     "required": true,
     "type": "text",
     "unique": true
    },
    {
     "name": "Author",
     "required": true,
     "type": "text",
     "validator": "person_name"
    },
    {
     "choices": [
      "Fiction",
      "Non-fiction",
      "Poetry",
      "Biography"
     ],
     "default": "Fiction",
     "name": "Genre",
     "type": "choice"
    },
    {
     "lookupTable": "Members",
     "name": "Reader",
     "type": "lookup"
    },
    {
     "min": 1,
     "name": "Pages",
     "type": "integer"
    },
    {
     "name": "Started",
     "type": "date"
    },
    {
     "name": "Finished",
     "type": "date",
     "validator": "on_or_after_field",
     "validatorArg": "Started"
    },
    {
     "max": 5,
     "min": 1,
     "name": "Rating",
     "type": "integer"
    },
    {
     "auto": "created",
     "name": "Added",
     "type": "datetime"
    }
   ],
   "label": "Books",
   "name": "Books"
  }
 ]
}