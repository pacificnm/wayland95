     "props": {
      "alignment": "Right"
     },
     "events": {
      "changed": "work();"
     }
    },
    {
     "type": "Label",
     "name": "resultLabel",
     "x": 8,
     "y": 150,
     "width": 280,
     "height": 60,
     "props": {
      "text": "",
      "wordWrap": true,
      "borderStyle": "Sunken"
     },
     "events": {}
    },
    {
     "type": "Graph",
     "name": "graph1",
     "x": 296,
     "y": 8,
     "width": 416,
     "height": 202,
     "props": {
      "graph": {
       "type": "Line",
       "source": "code",
       "legend": "None",
       "title": "What's still owed",
       "prefix": "$",
       "markers": false
      }
     },
     "events": {}
    },
    {
     "type": "DataGrid",
     "name": "grid",
     "x": 8,
     "y": 218,
     "width": 704,
     "height": 234,
     "props": {
      "table": "Listing",
      "columns": [
       "Num",
       "Payment",
       "Principal",
       "Interest",
       "Balance"
      ]
     },
     "events": {}
    }
   ],
   "code": {
    "general": "readonly property var home: App.form(\"HomeForm\")\nproperty var debtIds: []\n\nfunction work() {\n    var amount = home.parseMoney(amountBox.text), rate = Number(rateBox.text), years = Number(yearsBox.text);\n    var extra = home.parseMoney(extraBox.text) || 0;\n    if (amount === null || amount <= 0 || rateBox.text.trim() === \"\" || isNaN(rate) || rate < 0 || !(years > 0)) {\n        resultLabel.text = \"Type what's owed, the interest rate and how many years.\";\n        grid.rows = [];\n        graph1.setData([], []);\n        return;\n    }\n    var months = Math.round(years * 12), r = rate / 100 / 12;\n    var payment = r === 0 ? amount / months : amount * r / (1 - Math.pow(1 + r, -months));\n    var owed = amount, interest = 0, rows = [], labels = [], left = [], month = 0;\n    while (owed > 0.005 && month < 1200) {\n        month += 1;\n        var i = owed * r, p = Math.min(owed, payment + extra - i);\n        owed -= p;\n        interest += i;\n        rows.push({ id: month, Num: String(month), Payment: home.fmt(p + i), Principal: home.fmt(p), Interest: home.fmt(i),\n                    Balance: home.fmt(owed) });\n        if (month % 12 === 0 || owed <= 0.005) {\n            labels.push(\"Year \" + Math.ceil(month / 12));\n            left.push(Math.round(owed));\n        }\n    }\n    grid.rows = rows;\n    graph1.setData(labels, [{ name: \"Still owed\", values: left }]);\n    var plain = payment * months - amount;\n    resultLabel.text = home.fmt(payment + extra) + \" a month pays it off in \" + Math.floor(month / 12) + \" years\"\n        + (month % 12 ? \" and \" + (month % 12) + \" months\" : \"\") + \". Interest: \" + home.fmt(interest) + \" in all\"\n        + (extra > 0 ? \", \" + home.fmt(plain - interest) + \" less than without the extra.\" : \".\");\n}",
    "load": "var b = home.balances(), names = [];\nDb.select(\"Accounts\", { orderBy: \"Name\" }).forEach(function (a) {\n    if (home.isDebt(a.Type) && !a.Closed) {\n        debtIds.push(a.id);\n        names.push(a.Name);\n    }\n});\naccountCombo.items = names;\nwork();"
   }
  },
  {
   "name": "AdvisorForm",
   "width": 480,
   "height": 460,
   "props": {
    "title": "Advisor"
   },
   "controls": [
    {
     "type": "AIChat",
     "name": "chat1",
     "x": 8,
     "y": 8,
     "width": 464,
     "height": 412,
     "props": {
      "instructions": "You are the Advisor in Wayland Money, a personal finance program. You help the person understand their own money: what they spend, what they owe, what's due, how their investments are doing.\nUse the tools for figures instead of adding up records yourself: spending_by_category, account_balances and bills_due. Amounts are US dollars; in the Transactions table a negative Amount is money going out.\nKeep answers short and plain. Give figures, not investment recommendations: you are not a licensed adviser, and say so if asked what to buy or sell.",
      "greeting": "Hello! Ask me about your spending, your balances or what's due.",
      "formAccess": false
     },
     "events": {}
    },
    {
     "type": "Button",
     "name": "newButton",
     "x": 8,
     "y": 428,
     "width": 130,
     "height": 24,
     "props": {
      "text": "New Conversation"
     },
     "events": {
      "clicked": "chat1.clear();"
     }
    }
   ],
   "code": {
    "general": "readonly property var home: App.form(\"HomeForm\")",
    "load": "chat1.addTool(\"spending_by_category\",\n    \"What was spent and earned in each category between two days (transfers and trades left out). \"\n    + \"Use it for any question about spending, income, or where the money went.\",\n    { from: { type: \"string\", description: \"The first day, as YYYY-MM-DD.\" },\n      to: { type: \"string\", description: \"The last day, as YYYY-MM-DD.\" } },\n    function (input) {\n        return home.totalsByCategory(input.from, input.to).map(function (c) {\n            return { category: c.name, kind: c.kind, total: Math.round(c.total * 100) / 100 };\n        });\n    });\nchat1.addTool(\"account_balances\",\n    \"Every open account with its type and what it's worth today, and the net worth. \"\n    + \"Use it for questions about balances, debts or net worth.\",\n    {},\n    function () {\n        var b = home.balances(), w = home.netWorth();\n        return { accounts: Db.select(\"Accounts\", { orderBy: \"Name\" }).filter(function (a) { return !a.Closed; }).map(function (a) {\n                     return { name: a.Name, type: a.Type, cash: Math.round(b[a.id].cash * 100) / 100,\n                              investments: Math.round(b[a.id].holdings * 100) / 100 };\n                 }),\n                 assets: Math.round(w.assets * 100) / 100, liabilities: Math.round(w.liabilities * 100) / 100,\n                 netWorth: Math.round(w.net * 100) / 100 };\n    });\nchat1.addTool(\"bills_due\",\n    \"The bills and deposits coming up (or overdue), the soonest first. Use it when asked what's due.\",\n    {},\n    function () {\n        return home.billsDue().map(function (d) {\n            return { name: d.bill.Name, kind: d.bill.Kind, amount: d.bill.Amount, due: d.bill.NextDue, daysFromToday: d.days };\n        });\n    });"
   }
  },
  {
   "name": "AboutForm",
   "width": 300,
   "height": 172,
   "props": {
    "title": "About Wayland Money",
    "resizable": false
   },
   "controls": [
    {
     "type": "Shape",
     "name": "banner",
     "x": 0,
     "y": 0,
     "width": 300,
     "height": 48,
     "props": {
      "backColor": "#000080",
      "borderColor": "#000080"
     },
     "events": {}
    },
    {
     "type": "Label",
     "name": "titleLabel",
     "x": 16,
     "y": 12,
     "width": 268,
     "height": 24,
     "props": {
      "text": "Wayland Money",
      "foreColor": "#ffffff",
      "fontBold": true,
      "fontSize": 18
     },
     "events": {}
    },
    {
     "type": "Label",
     "name": "versionLabel",
     "x": 16,
     "y": 60,
     "width": 268,
     "height": 17,
     "props": {
      "text": ""
     },
     "events": {}
    },
    {
     "type": "Label",
     "name": "madeLabel",
     "x": 16,
     "y": 82,
     "width": 268,
     "height": 17,
     "props": {
      "text": "Made in Wayland Studio."
     },
     "events": {}
    },
    {
     "type": "Label",
