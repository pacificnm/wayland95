<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The Services control panel's helper (wayland95-services), run through
     pkexec: an administrator's password, remembered for a few minutes so
     several changes in a row ask only once. -->
<policyconfig>
  <vendor>Wayland 95</vendor>
  <action id="org.wayland95.services">
    <description>Change server settings</description>
    <message>Services needs an administrator's password to change how this computer's servers run.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@WAYLAND95_SERVICES_HELPER@</annotate>
  </action>
</policyconfig>
