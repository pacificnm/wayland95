/*
 * The installer (Calamares) in Wayland 95's look: Windows Standard colors,
 * two-tone Win95 bevels (border images from make-images.py) and an 8pt
 * sans-serif. Object names come from Calamares's Debug window > Tools >
 * Widget Tree.
 */

* {
    font-family: "Liberation Sans";
    font-size: 11px;
}

QWidget {
    background-color: #c0c0c0;
    color: #000000;
    selection-background-color: #000080;
    selection-color: #ffffff;
}

QLabel {
    background: transparent;
}
QLabel:disabled {
    color: #808080;
}

QToolTip {
    background-color: #ffffe1;
    color: #000000;
    border: 1px solid #000000;
    padding: 1px;
}

/* --- push buttons ------------------------------------------------------- */

QPushButton, QToolButton {
    min-width: 59px;
    min-height: 17px;
    padding: 1px 6px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
}
QPushButton:default, QPushButton:focus {
    border-width: 3px;
    padding: 0px 5px;
    border-image: url(/etc/calamares/branding/wayland95/raised-default.png) 3 3 3 3 stretch;
}
QPushButton:pressed, QToolButton:pressed, QToolButton:checked {
    border-width: 2px;
    padding: 2px 5px 0px 7px;
    border-image: url(/etc/calamares/branding/wayland95/pressed.png) 2 2 2 2 stretch;
}
QPushButton:disabled, QToolButton:disabled {
    color: #808080;
}
QPushButton:flat {
    border-image: none;
    border: none;
}
QToolButton {
    min-width: 0px;
}

/* --- text boxes, lists and trees ---------------------------------------- */

QLineEdit, QTextEdit, QPlainTextEdit, QTextBrowser,
QListView, QTreeView, QTableView, QListWidget, QTreeWidget, QTableWidget {
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/sunken.png) 2 2 2 2 stretch;
    background-color: #ffffff;
    color: #000000;
}
QLineEdit {
    padding: 1px 2px;
    min-height: 17px;
}
QLineEdit:disabled, QLineEdit:read-only, QTextEdit:disabled, QTextBrowser:disabled {
    border-image: url(/etc/calamares/branding/wayland95/sunken-face.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
    color: #808080;
}
QTextBrowser, QTextEdit[readOnly="true"], QPlainTextEdit[readOnly="true"] {
    background-color: #ffffff;
}

QListView::item, QTreeView::item {
    padding: 1px;
    border: none;
}
QListView::item:selected, QTreeView::item:selected,
QListView::item:selected:active, QTreeView::item:selected:active {
    background-color: #000080;
    color: #ffffff;
}
QListView::item:selected:!active, QTreeView::item:selected:!active {
    background-color: #000080;
    color: #ffffff;
}
QListView::item:hover, QTreeView::item:hover {
    background: transparent;
}
QListView::item:selected:hover, QTreeView::item:selected:hover {
    background-color: #000080;
}
QTreeView::branch {
    background: #ffffff;
}

QHeaderView {
    background-color: #c0c0c0;
}
QHeaderView::section {
    background-color: #c0c0c0;
    color: #000000;
    padding: 2px 4px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
}
QTableCornerButton::section {
    background-color: #c0c0c0;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
}

/* --- drop-down lists ------------------------------------------------------ */

QComboBox {
    min-height: 17px;
    padding: 1px 2px 1px 3px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/sunken.png) 2 2 2 2 stretch;
    background-color: #ffffff;
    color: #000000;
}
QComboBox:disabled {
    border-image: url(/etc/calamares/branding/wayland95/sunken-face.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
    color: #808080;
}
QComboBox:focus {
    background-color: #ffffff;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 16px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
}
QComboBox::drop-down:on {
    border-image: url(/etc/calamares/branding/wayland95/pressed.png) 2 2 2 2 stretch;
}
QComboBox::down-arrow {
    image: url(/etc/calamares/branding/wayland95/arrow-down.png);
    width: 7px;
    height: 4px;
}
QComboBox::down-arrow:disabled {
    image: url(/etc/calamares/branding/wayland95/arrow-down-disabled.png);
}
QComboBox QAbstractItemView {
    border: 1px solid #000000;
    border-image: none;
    background-color: #ffffff;
    selection-background-color: #000080;
    selection-color: #ffffff;
    outline: 0;
}

/* --- spin boxes ------------------------------------------------------------ */

QSpinBox, QDoubleSpinBox {
    min-height: 17px;
    padding: 1px 18px 1px 2px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/sunken.png) 2 2 2 2 stretch;
    background-color: #ffffff;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    border-image: url(/etc/calamares/branding/wayland95/sunken-face.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
    color: #808080;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 16px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    border-image: url(/etc/calamares/branding/wayland95/pressed.png) 2 2 2 2 stretch;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(/etc/calamares/branding/wayland95/arrow-up.png);
    width: 7px; height: 4px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(/etc/calamares/branding/wayland95/arrow-down.png);
    width: 7px; height: 4px;
}

/* --- check boxes and option buttons ---------------------------------------- */

QCheckBox, QRadioButton {
    spacing: 5px;
    background: transparent;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #808080;
}
QCheckBox::indicator {
    width: 9px;
    height: 9px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/sunken.png) 2 2 2 2 stretch;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    image: url(/etc/calamares/branding/wayland95/check.png);
}
QCheckBox::indicator:disabled, QCheckBox::indicator:pressed {
    background-color: #c0c0c0;
    border-image: url(/etc/calamares/branding/wayland95/sunken-face.png) 2 2 2 2 stretch;
}
QCheckBox::indicator:checked:disabled {
    image: url(/etc/calamares/branding/wayland95/check-disabled.png);
}
QRadioButton::indicator {
    width: 12px;
    height: 12px;
    image: url(/etc/calamares/branding/wayland95/radio.png);
}
QRadioButton::indicator:checked {
    image: url(/etc/calamares/branding/wayland95/radio-checked.png);
}
QRadioButton::indicator:disabled {
    image: url(/etc/calamares/branding/wayland95/radio-disabled.png);
}
QRadioButton::indicator:checked:disabled {
    image: url(/etc/calamares/branding/wayland95/radio-checked-disabled.png);
}

/* --- group boxes and frames ---------------------------------------------- */

QGroupBox {
    margin-top: 7px;
    padding-top: 6px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/etched.png) 2 2 2 2 stretch;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 2px;
    background-color: #c0c0c0;
}

/* --- scroll bars ------------------------------------------------------------ */

QScrollBar:vertical {
    width: 16px;
    margin: 16px 0;
    border: none;
    background-image: url(/etc/calamares/branding/wayland95/dither.png);
}
QScrollBar:horizontal {
    height: 16px;
    margin: 0 16px;
    border: none;
    background-image: url(/etc/calamares/branding/wayland95/dither.png);
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    min-height: 8px;
    min-width: 8px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
}
QScrollBar::add-line, QScrollBar::sub-line {
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
}
QScrollBar::add-line:pressed, QScrollBar::sub-line:pressed {
    border-image: url(/etc/calamares/branding/wayland95/pressed.png) 2 2 2 2 stretch;
}
QScrollBar::add-line:vertical { height: 16px; subcontrol-position: bottom; subcontrol-origin: margin; }
QScrollBar::sub-line:vertical { height: 16px; subcontrol-position: top; subcontrol-origin: margin; }
QScrollBar::add-line:horizontal { width: 16px; subcontrol-position: right; subcontrol-origin: margin; }
QScrollBar::sub-line:horizontal { width: 16px; subcontrol-position: left; subcontrol-origin: margin; }
QScrollBar::up-arrow { image: url(/etc/calamares/branding/wayland95/arrow-up.png); width: 7px; height: 4px; }
QScrollBar::down-arrow { image: url(/etc/calamares/branding/wayland95/arrow-down.png); width: 7px; height: 4px; }
QScrollBar::left-arrow { image: url(/etc/calamares/branding/wayland95/arrow-left.png); width: 4px; height: 7px; }
QScrollBar::right-arrow { image: url(/etc/calamares/branding/wayland95/arrow-right.png); width: 4px; height: 7px; }
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* --- progress bars: Win95's blue blocks ----------------------------------- */

QProgressBar {
    min-height: 16px;
    max-height: 18px;
    border-width: 1px;
    border-image: url(/etc/calamares/branding/wayland95/thin-sunken.png) 1 1 1 1 stretch;
    background-color: #c0c0c0;
    color: #000000;
    text-align: center;
    padding: 1px;
}
QProgressBar::chunk {
    background-color: #000080;
    width: 8px;
    margin-right: 2px;
}

/* --- tabs ------------------------------------------------------------------- */

QTabWidget::pane {
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    top: -2px;
}
QTabBar::tab {
    background-color: #c0c0c0;
    padding: 3px 8px;
    border: 1px solid #808080;
    border-top-color: #ffffff;
    border-left-color: #ffffff;
    border-bottom: none;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    margin-right: -1px;
}
QTabBar::tab:!selected {
    margin-top: 2px;
}

/* --- menus (right-click menus in text boxes) ------------------------------ */

QMenu {
    background-color: #c0c0c0;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    padding: 1px;
}
QMenu::item {
    padding: 3px 20px 3px 20px;
    background: transparent;
}
QMenu::item:selected {
    background-color: #000080;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #808080;
}
QMenu::separator {
    height: 2px;
    margin: 3px 1px;
    border-top: 1px solid #808080;
    border-bottom: 1px solid #ffffff;
}

/* --- sliders (keyboard and locale pages don't use them, but just in case) --- */

QSlider::groove:horizontal {
    height: 4px;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/sunken.png) 2 2 2 2 stretch;
}
QSlider::handle:horizontal {
    width: 11px;
    margin: -8px 0;
    border-width: 2px;
    border-image: url(/etc/calamares/branding/wayland95/raised.png) 2 2 2 2 stretch;
    background-color: #c0c0c0;
}

/* --- Calamares's own parts --------------------------------------------- */

/* the page area */
#mainApp {
    background-color: #c0c0c0;
}

/* the welcome page's links (Support, Known issues, Release notes) look
   like ordinary buttons */
#supportButton, #knownIssuesButton, #releaseNotesButton, #donateButton, #aboutButton {
    padding: 1px 10px;
}
