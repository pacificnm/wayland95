    },
    {
     "type": "TextBox",
     "name": "amountBox",
     "x": 336,
     "y": 214,
     "width": 96,
     "height": 21,
     "props": {
      "alignment": "Right"
     },
     "events": {
      "accepted": "if (saveLine())\n    startNew();"
     }
    },
    {
     "type": "Label",
     "name": "memoLabel",
     "x": 8,
     "y": 244,
     "width": 60,
     "height": 17,
     "props": {
      "text": "Memo:"
     },
     "events": {}
    },
    {
     "type": "TextBox",
     "name": "memoBox",
     "x": 72,
     "y": 242,
     "width": 360,
     "height": 21,
     "props": {
      "field": "Memo"
     },
     "events": {}
    },
    {
     "type": "Button",
     "name": "addButton",
     "x": 8,
     "y": 276,
     "width": 90,
     "height": 24,
     "props": {
      "text": "Save Part",
      "isDefault": true
     },
     "events": {
      "clicked": "if (saveLine())\n    startNew();"
     }
    },
    {
     "type": "Button",
     "name": "deleteButton",
     "x": 104,
     "y": 276,
     "width": 90,
     "height": 24,
     "props": {
      "text": "Delete Part"
     },
     "events": {
      "clicked": "if (!form.isNew) {\n    form.deleteRecord();\n    fill();\n}\nstartNew();"
     }
    },
    {
     "type": "Button",
     "name": "doneButton",
     "x": 342,
     "y": 276,
     "width": 90,
     "height": 24,
     "props": {
      "text": "Done"
     },
     "events": {
      "clicked": "if (left === 0 || grid.rows.length === 0) {\n    form.close();\n    return;\n}\nform.msgBox(\"The parts don't add up to the transaction (\" + home.fmt(Math.abs(left)) + \" is left).\\n\"\n            + \"Change the transaction's amount to what the parts come to?\", \"Split\", \"question\",\n            [\"Change It\", \"Keep Editing\"], function (answer) {\n    if (answer !== 0)\n        return;\n    var t = Db.get(\"Transactions\", transactionId);\n    Db.update(\"Transactions\", transactionId, { Amount: t.Amount - left });\n    home.matchTransfer(transactionId);\n    form.close();\n});"
     }
    }
   ],
   "code": {
    "general": "readonly property var home: App.form(\"HomeForm\")\nproperty var transactionId: null\nproperty real left: 0\n\nfunction fill() {\n    var t = Db.get(\"Transactions\", transactionId), categories = home.names(\"Categories\");\n    var sign = t.Amount < 0 ? -1 : 1, total = 0, out = [];\n    Db.select(\"Splits\", { where: { Transaction: transactionId } }).forEach(function (s) {\n        total += s.Amount;\n        out.push({ id: s.id, Category: categories[s.Category] || \"\", Memo: s.Memo || \"\", Amount: home.fmt(sign * s.Amount) });\n    });\n    grid.rows = out;\n    left = Math.round((t.Amount - total) * 100) / 100;\n    totalLabel.text = home.showDate(t.Date) + \"   \" + (t.Memo || \"\") + \"   \" + home.fmt(Math.abs(t.Amount))\n        + (t.Amount < 0 ? \" spent\" : \" received\");\n    leftLabel.text = left === 0 ? \"All of it has a category.\" : \"Still to give a category: \" + home.fmt(sign * left);\n    leftLabel.foreColor = left === 0 ? \"#008000\" : \"#c00000\";\n    // (the transaction is a split while it has any)\n    if (t.IsSplit !== (out.length > 0))\n        Db.update(\"Transactions\", transactionId, out.length > 0 ? { IsSplit: true, Category: null } : { IsSplit: false });\n}\n\nfunction startNew() {\n    form.newRecord();\n    amountBox.text = left !== 0 ? home.fmt(Math.abs(left)) : \"\";\n    grid.currentIndex = -1;\n    categoryCombo.forceActiveFocus();\n}\n\nfunction saveLine() {\n    var amount = home.parseMoney(amountBox.text);\n    if (amount === null || amount === 0) {\n        form.msgBox(\"Type this part's amount.\", \"Split\", \"warning\");\n        return false;\n    }\n    var t = Db.get(\"Transactions\", transactionId);\n    form.setField(\"Transaction\", transactionId);\n    form.setField(\"Amount\", (t.Amount < 0 ? -1 : 1) * Math.abs(amount));\n    if (!form.save())\n        return false;\n    fill();\n    return true;\n}",
    "load": "transactionId = form.args.transaction;\nfill();\nstartNew();",
    "current": "amountBox.text = form.record.Amount ? home.fmt(Math.abs(form.record.Amount)) : \"\";"
   }
  },
