    {
     "type": "Button",
     "name": "findButton",
     "x": 624,
     "y": 34,
     "width": 88,
     "height": 24,
     "props": {
      "text": "Find",
      "isDefault": true
     },
     "events": {
      "clicked": "find();"
     }
    },
    {
     "type": "DataGrid",
     "name": "grid",
     "x": 8,
     "y": 68,
     "width": 704,
     "height": 340,
     "props": {
      "table": "Listing",
      "columns": [
       "Date",
       "Account",
       "Num",
       "Payee",
       "Category",
       "Memo",
       "Amount"
      ]
     },
     "events": {
      "rowActivated": "var t = Db.get(\"Transactions\", grid.currentId);\nApp.openForm(\"RegisterForm\", { account: t.Account, transaction: t.id });"
     }
    },
    {
     "type": "Label",
     "name": "countLabel",
     "x": 8,
     "y": 416,
     "width": 704,
     "height": 17,
     "props": {
      "text": ""
     },
     "events": {}
    }
   ],
   "code": {
    "general": "readonly property var home: App.form(\"HomeForm\")\nproperty var accountIds: []\n\nfunction find() {\n    var payees = home.names(\"Payees\"), categories = home.names(\"Categories\"), accounts = home.names(\"Accounts\");\n    var text = findBox.text.trim().toLowerCase();\n    var only = accountCombo.currentIndex > 0 ? accountIds[accountCombo.currentIndex - 1] : null;\n    var from = fromPicker.value, to = toPicker.value;\n    var least = home.parseMoney(leastBox.text), most = home.parseMoney(mostBox.text);\n    var out = [], total = 0;\n    Db.select(\"Transactions\", { where: only === null ? {} : { Account: only }, orderBy: \"Date\", descending: true }).forEach(function (t) {\n        if ((from && t.Date < from) || (to && t.Date > to))\n            return;\n        var size = Math.abs(t.Amount);\n        if ((least !== null && size < least) || (most !== null && size > most))\n            return;\n        var line = { id: t.id, Date: home.showDate(t.Date), Account: accounts[t.Account] || \"\", Num: t.Number || \"\",\n                     Payee: payees[t.Payee] || \"\", Category: t.TransferAccount ? \"Transfer\" : t.IsSplit ? \"(split)\" : (categories[t.Category] || \"\"),\n                     Memo: t.Memo || \"\", Amount: home.fmt(t.Amount) };\n        if (text !== \"\" && (line.Payee + \" \" + line.Category + \" \" + line.Memo + \" \" + line.Num + \" \" + line.Account)\n                .toLowerCase().indexOf(text) < 0)\n            return;\n        out.push(line);\n        total += t.Amount;\n    });\n    grid.rows = out;\n    countLabel.text = out.length + (out.length === 1 ? \" transaction\" : \" transactions\") + \", \" + home.fmt(total) + \" in all\";\n}",
    "load": "var accounts = Db.select(\"Accounts\", { orderBy: \"Name\" });\naccountIds = accounts.map(function (a) { return a.id; });\naccountCombo.items = [\"(all accounts)\"].concat(accounts.map(function (a) { return a.Name; }));\naccountCombo.currentIndex = 0;\n// (a report's slice was clicked: its transactions)\nif (form.args.text)\n    findBox.text = form.args.text;\nif (form.args.from)\n    fromPicker.value = form.args.from;\nif (form.args.to)\n    toPicker.value = form.args.to;\nfind();"
   }
  },
  {
   "name": "BillsForm",
   "width": 644,
   "height": 473,
   "props": {
    "title": "Bills and Deposits",
    "table": "Bills"
   },
   "code": {
    "general": "readonly property var home: App.form(\"HomeForm\")\n\nfunction check() {\n    if (form.record.Kind === \"Transfer\" && !form.record.ToAccount) {\n        form.msgBox(\"A transfer needs the account the money goes to.\", \"Bills\", \"warning\");\n        return false;\n    }\n    return true;\n}",
    "current": "if (form.isNew) {\n    dueLabel.text = \"A new bill: fill it in and press Save.\";\n} else {\n    var days = home.daysBetween(home.today(), form.record.NextDue);\n    dueLabel.text = !form.record.Active ? \"This one is finished.\"\n                  : days < 0 ? \"Overdue by \" + (-days) + (days === -1 ? \" day.\" : \" days.\")\n                  : days === 0 ? \"Due today.\" : \"Due in \" + days + (days === 1 ? \" day.\" : \" days.\");\n}\ntoAccountLabel.visible = toAccountCombo.visible = form.record.Kind === \"Transfer\";"
   },
