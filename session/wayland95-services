#!/bin/sh
# wayland95-services: the few things the Services control panel needs root
# for. win95control runs it through pkexec (polkit asks for the password;
# org.wayland95.services.policy). It only does the jobs below, and checks
# every value it is given; settings arrive as KEY=VALUE lines on stdin.
#
#   unit enable|disable|start|stop|restart ssh|postgresql
#   ssh-config            < Port= PasswordAuthentication= PermitRootLogin= ...
#   pg-config             < listen= port= max_connections= remote=
#   pg-role NAME [superuser]
#   unit ... mysql        MariaDB (Debian's MySQL)
#   my-config             < listen= port= max_connections=
#   my-role NAME [admin]  a MySQL account for NAME, logging on as that user
#   my-password NAME      < a password for NAME's logons over the network
#                           (none: no network logons)
#   unit ... samba        smbd (and nmbd, if it's there)
#   smb-config            < workgroup= description= share=NAME\tFOLDER\tread|full\tme|anyone\tCOMMENT ...
#                           (the caller's shared folders: all of them; each
#                           acts as its owner, who must own the folder)
#   smb-password          < the caller's Samba password (none: taken away)
#   unit ... nginx
#   nginx-config          < listen= port= root= autoindex=  (the website's
#                           folder: in /var/www, /srv or the caller's home,
#                           which nginx is then let into, read-only)
#   www-own               /var/www/html becomes the caller's, to edit
#   update-source         Wayland 95's update repository, for apt
#   login-theme wayland95|default   the login screen: Wayland 95's own SDDM
#                           theme, or whatever SDDM used before
#   unit ... wireguard | wireguard:NAME   every tunnel, or one (wg-quick@NAME)
#   wg-list               the tunnels (/etc/wireguard/NAME.conf): NAME enabled active
#   wg-show NAME          one tunnel's settings and state, without its secrets
#   wg-save NAME          < [interface] / [peer] sections of KEY=VALUE lines
#   wg-import NAME        < a WireGuard .conf file
#   wg-delete NAME
#
# A tunnel's private and preshared keys never leave here: wg-show gives the
# public key and whether a preshared key is set; wg-save takes "keep",
# "generate" (the private key), "none" (a preshared key) or a new key.
# Commands a .conf may run as root (PreUp, PostUp, PreDown, PostDown) are
# kept if they're in the file already, and never taken from wg-save or
# wg-import.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022
cd /

die() { echo "$*" >&2; exit 1; }

yesno() { case "$2" in yes|no) ;; *) die "$1 must be yes or no";; esac; }
number() { # name value min max
    case "$2" in ''|*[!0-9]*) die "$1 must be a number";; esac
    [ "$2" -ge "$3" ] && [ "$2" -le "$4" ] || die "$1 must be between $3 and $4"
}
# writes stdin to FILE through a temporary file in the same folder
put() {
    tmp=$(mktemp "$1.XXXXXX")
    cat >"$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$1"
}

ssh_units() {
    # Debian starts sshd as ssh.service; Ubuntu through ssh.socket.
    # One line, separated by spaces: the service, if there, comes last.
    list=""
    for u in ssh.socket ssh.service; do
        systemctl cat "$u" >/dev/null 2>&1 && list="$list $u"
    done
    echo "${list# }"
}

pg_cluster() { # newest cluster: "VERSION NAME PORT ..."
    command -v pg_lsclusters >/dev/null || die "PostgreSQL isn't installed."
    c=$(pg_lsclusters -h | sort -V | tail -n 1)
    [ -n "$c" ] || die "PostgreSQL has no database cluster (see pg_createcluster)."
    echo "$c"
}

# ------------------------------------------------------------ MySQL
my_installed() {
    [ -d /etc/mysql ] && command -v mariadb >/dev/null || die "MySQL (MariaDB) isn't installed."
}
# a user name that's safe in SQL quotes and as a database name
my_name() {
    case "$1" in ''|-*|*[!A-Za-z0-9_-]*) die "Not a usable MySQL account name: $1 (letters, digits, - and _)";; esac
    [ ${#1} -le 32 ] || die "The name is too long."
}
# root's own way in: its socket, as root (Debian's root@localhost)
my_sql() { mariadb --protocol=socket -u root -N -B "$@"; }
# what NAME's grants are for: its own database and NAME_..., or all
# (admin); _ is a wildcard in grants, so it's escaped
my_grants() { # NAME HOST ADMIN
    esc=$(printf '%s' "$1" | sed 's/_/\\_/g')
    printf '%s\n' \
        "GRANT ALL PRIVILEGES ON \`$esc\`.* TO '$1'@'$2';" \
        "GRANT ALL PRIVILEGES ON \`$esc\\_%\`.* TO '$1'@'$2';"
    [ "$3" = yes ] && echo "GRANT ALL PRIVILEGES ON *.* TO '$1'@'$2' WITH GRANT OPTION;"
    return 0
}

# ------------------------------------------------------------ Samba
SMB_CONF=/etc/samba/smb.conf
SMB_OURS=/etc/samba/wayland95.conf
smb_installed() {
    [ -f "$SMB_CONF" ] && systemctl cat smbd.service >/dev/null 2>&1 || die "Samba isn't installed."
}
# pkexec's caller: uid, user, home
smb_caller() {
    uid=${PKEXEC_UID:-}
    case "$uid" in ''|*[!0-9]*) die "Run this through pkexec." ;; esac
    [ "$uid" != 0 ] || die "Share folders as yourself, not as root."
    entry=$(getent passwd "$uid") || die "No such user: $uid."
    user=${entry%%:*}
    home=$(echo "$entry" | cut -d: -f6)
    [ -n "$user" ] && [ -n "$home" ] && [ "$home" != / ] || die "No home folder for user $uid."
}
# a description or a folder's comment, as smb.conf will read it: one line
# with no quotes or backslashes, and % only for Samba's %h, %v and %L
smb_text() { # what value
    case "$2" in *[[:cntrl:]\"\\]*) die "$1 can't have \" or \\ in it." ;; esac
    case "$(printf '%s' "$2" | sed 's/%[hvL]//g')" in *%*) die "$1 can't have % in it (only %h, %v or %L)." ;; esac
    [ ${#2} -le 80 ] || die "$1 can have 80 characters at most."
}
smb_lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

wg_name() {
    case "$1" in ''|*[!A-Za-z0-9_=+.-]*) die "Not a usable tunnel name: $1 (letters, digits, - and _)";; esac
    [ ${#1} -le 15 ] || die "A tunnel's name can have 15 characters at most."
}
wg_names() { # every tunnel there is
    for f in /etc/wireguard/*.conf; do
        [ -f "$f" ] || continue
        n=${f##*/}
        echo "${n%.conf}"
    done
}
wg_key() { # name value
    case "$2" in
        ???????????????????????????????????????????=) ;;
        *) die "$1 isn't a WireGuard key (44 characters ending in =)." ;;
    esac
    case "$2" in *[!A-Za-z0-9+/=]*) die "$1 isn't a WireGuard key.";; esac
}
# A .conf as sections of KEY=VALUE lines ("[interface]", then a "[peer]"
# for each), secrets included; values given more than once are joined with
# ", ". Other lines of [Interface] (Table, FwMark, PreUp...) come out as
# "other=LINE".
wg_parse() { # FILE (or - for stdin)
    awk '
        function flush(   i) {
            if (section == "") return
            print "[" section "]"
            for (i = 1; i <= n; ++i) print order[i] "=" val[order[i]]
            for (i = 1; i <= others; ++i) print "other=" other[i]
            delete val; n = 0; others = 0
        }
        { sub(/\r$/, "") }
        /^[ \t]*(#|$)/ { next }
        /^[ \t]*\[[A-Za-z]+\][ \t]*$/ {
            flush()
            s = tolower($0); gsub(/[^a-z]/, "", s); section = s
            next
        }
        section != "" {
            line = $0
            eq = index(line, "=")
            if (!eq) next
            key = substr(line, 1, eq - 1); value = substr(line, eq + 1)
            gsub(/^[ \t]+|[ \t]+$/, "", key); gsub(/^[ \t]+|[ \t]+$/, "", value)
            sub(/[ \t]+#.*$/, "", value)
            lk = tolower(key)
            name = ""
            if (lk == "privatekey") name = "PrivateKey"
            else if (lk == "address") name = "Address"
            else if (lk == "listenport") name = "ListenPort"
            else if (lk == "dns") name = "DNS"
            else if (lk == "mtu") name = "MTU"
            else if (lk == "publickey") name = "PublicKey"
            else if (lk == "presharedkey") name = "PresharedKey"
            else if (lk == "allowedips") name = "AllowedIPs"
            else if (lk == "endpoint") name = "Endpoint"
            else if (lk == "persistentkeepalive") name = "PersistentKeepalive"
            if (name == "") { if (section == "interface") other[++others] = key " = " value; next }
            if (name in val) val[name] = val[name] ", " value
            else { val[name] = value; order[++n] = name }
        }
        END { flush() }
    ' "$1"
}
# Writes /etc/wireguard/NAME.conf from sections on stdin (as wg_parse gives
# them, but "other" lines are not taken: those of the file there now are
# kept). $2 = import: a new tunnel from a .conf (no "keep").
wg_write() {
    name=$1 mode=${2:-save}
    conf=/etc/wireguard/$name.conf
    old=""
    [ -f "$conf" ] && old=$(wg_parse "$conf")
    old_private=$(printf '%s\n' "$old" | sed -n '/^\[interface\]$/,/^\[peer\]$/s/^PrivateKey=//p' | head -n 1)
    section="" out_if="" out_peers="" peer="" peer_key="" have_private="" peers=0
    end_peer() {
        [ -n "$peer" ] || return 0
        [ -n "$peer_key" ] || die "A peer needs its public key."
        out_peers="$out_peers
[Peer]
$peer"
        peer="" peer_key=""
        peers=$((peers + 1))
    }
    while IFS= read -r line; do
        case "$line" in
            '') continue ;;
            '[interface]') [ -z "$section" ] || die "The interface comes first, once."; section=interface; continue ;;
            '[peer]') [ -n "$section" ] || die "The interface comes first."; end_peer; section=peer; continue ;;
        esac
        key=${line%%=*} value=${line#*=}
        [ "$key" != "$line" ] || die "Not a setting: $line"
        [ -n "$section" ] || die "The interface comes first."
        case "$section:$key" in
            interface:PrivateKey)
                case "$value" in
                    keep) [ "$mode" = save ] && [ -n "$old_private" ] || die "There's no private key to keep."
                          value=$old_private ;;
                    generate) value=$(wg genkey) ;;
                    *) wg_key "the private key" "$value" ;;
                esac
                out_if="${out_if}PrivateKey = $value
"
                have_private=1 ;;
            interface:Address)
                [ -n "$value" ] || continue
                case "$value" in *[!0-9A-Fa-f:./,\ ]*) die "Address: IP addresses with their prefix (10.0.0.2/32), separated by commas";; esac
                out_if="${out_if}Address = $value
" ;;
            interface:ListenPort)
                [ -n "$value" ] || continue
                number "The listen port" "$value" 1 65535
                out_if="${out_if}ListenPort = $value
" ;;
            interface:DNS)
                [ -n "$value" ] || continue
                case "$value" in *[!0-9A-Za-z:.,\ -]*) die "DNS: addresses or domain names, separated by commas";; esac
                out_if="${out_if}DNS = $value
" ;;
            interface:MTU)
                [ -n "$value" ] || continue
                number "The MTU" "$value" 576 65535
                out_if="${out_if}MTU = $value
" ;;
            interface:other)
                # (from a file being imported: left out; never from wg-save)
                [ "$mode" = import ] || die "Unknown WireGuard setting: other" ;;
            peer:PublicKey)
                wg_key "A peer's public key" "$value"
                peer_key=$value
                peer="${peer}PublicKey = $value
" ;;
            peer:PresharedKey)
                case "$value" in
                    ''|none) continue ;;
                    keep)
                        [ "$mode" = save ] && [ -n "$peer_key" ] || die "A peer's public key comes before its preshared key."
                        value=$(printf '%s\n' "$old" | awk -v want="PublicKey=$peer_key" '
                            /^\[peer\]$/ { on = 0 } $0 == want { on = 1 } on && /^PresharedKey=/ { sub(/^PresharedKey=/, ""); print; exit }')
                        [ -n "$value" ] || continue ;;
                    *) wg_key "A preshared key" "$value" ;;
                esac
                peer="${peer}PresharedKey = $value
" ;;
            peer:AllowedIPs)
                [ -n "$value" ] || continue
                case "$value" in *[!0-9A-Fa-f:./,\ ]*) die "Allowed IPs: networks (10.0.0.0/24, 0.0.0.0/0), separated by commas";; esac
                peer="${peer}AllowedIPs = $value
" ;;
            peer:Endpoint)
                [ -n "$value" ] || continue
                case "$value" in *[!0-9A-Za-z:.\[\]_-]*|*:*) ;; *) die "Endpoint: a host and port (vpn.example.com:51820)";; esac
                case "$value" in *[!0-9A-Za-z:.\[\]_-]*) die "Endpoint: a host and port (vpn.example.com:51820)";; esac
                peer="${peer}Endpoint = $value
" ;;
            peer:PersistentKeepalive)
                case "$value" in ''|0|off) continue ;; esac
                number "Persistent keepalive" "$value" 1 65535
                peer="${peer}PersistentKeepalive = $value
" ;;
            *) die "Unknown WireGuard setting: $key" ;;
        esac
    done
    end_peer
    [ -n "$have_private" ] || die "The tunnel needs a private key."
    # what the file there now has besides (Table, FwMark, its own commands)
    kept=$(printf '%s\n' "$old" | sed -n '/^\[interface\]$/,/^\[peer\]$/s/^other=//p')
    mkdir -p /etc/wireguard
    chmod 700 /etc/wireguard
    backup=""
    if [ -f "$conf" ]; then
        backup=$(mktemp "$conf.old.XXXXXX")
        cp -p "$conf" "$backup"
    fi
    tmp=$(mktemp "$conf.XXXXXX")
    chmod 600 "$tmp"
    {
        printf '[Interface]\n%s' "$out_if"
        [ -z "$kept" ] || printf '%s\n' "$kept"
        printf '%s\n' "$out_peers"
    } >"$tmp"
    mv -f "$tmp" "$conf"
    restore() {
        if [ -n "$backup" ]; then mv -f "$backup" "$conf"; else rm -f "$conf"; fi
    }
    if ! check=$(wg-quick strip "$name" 2>&1 >/dev/null); then
        restore
        die "WireGuard didn't accept these settings: $check"
    fi
    if systemctl is-active -q "wg-quick@$name.service" 2>/dev/null; then
        if ! systemctl restart "wg-quick@$name.service"; then
            restore
            [ -z "$backup" ] || systemctl restart "wg-quick@$name.service" || true
            die "The tunnel didn't start with these settings (they were put back)."
        fi
    fi
    [ -z "$backup" ] || rm -f "$backup"
}

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
unit)
    [ $# -eq 2 ] || die "usage: unit ACTION SERVICE"
    action=$1
    all=no
    case "$2" in
        ssh) units=$(ssh_units) ;;
        postgresql) units=postgresql.service ;;
        mysql|mariadb) units=""; systemctl cat mariadb.service >/dev/null 2>&1 && units=mariadb.service ;;
        nginx) units=""; systemctl cat nginx.service >/dev/null 2>&1 && units=nginx.service ;;
        samba|smbd)
            # smbd shares the folders; nmbd (if there) answers to the
            # computer's name, for older Windows' Network Neighborhood
            units="" all=yes
            if systemctl cat smbd.service >/dev/null 2>&1; then
                systemctl cat nmbd.service >/dev/null 2>&1 && units="nmbd.service "
                units="${units}smbd.service"
            fi ;;
        wireguard|wireguard:*)
            command -v wg-quick >/dev/null || die "WireGuard isn't installed."
            if [ "$2" = wireguard ]; then names=$(wg_names); else names=${2#wireguard:}; wg_name "$names"; fi
            for n in $names; do
                [ -f "/etc/wireguard/$n.conf" ] || die "There's no tunnel called $n."
                case "$action" in
                    enable) systemctl enable --now "wg-quick@$n.service" ;;
                    disable) systemctl disable --now "wg-quick@$n.service" ;;
                    start|stop|restart) systemctl "$action" "wg-quick@$n.service" ;;
                    *) die "Unknown action: $action" ;;
                esac || die "Tunnel $n: that didn't work. $(systemctl status "wg-quick@$n.service" 2>&1 | tail -n 3 | tr '\n' ' ')"
            done
            exit 0 ;;
        *) die "Unknown service: $2" ;;
    esac
    [ -n "$units" ] || die "$2 isn't installed."
    # what's started: the last unit (ssh's service, not its socket), or all
    main=${units##* }
    [ "$all" = no ] || main=$units
    case "$action" in
        enable)
            if [ "$2" = ssh ] && systemctl is-enabled -q ssh.socket 2>/dev/null; then
                systemctl start ssh.socket
            else
                systemctl enable --now $main
            fi ;;
        disable) systemctl disable --now $units ;;
        start) systemctl start $main ;;
        stop) systemctl stop $units ;;
        restart) systemctl restart $main ;;
        *) die "Unknown action: $action" ;;
    esac
    ;;

ssh-config)
    # the drop-in comes before the rest of sshd_config (Include is at its
    # top, and sshd takes the first value it reads), so these win
    out="# Written by the Wayland 95 Services control panel; changes here are overwritten.
"
    while IFS='=' read -r key value; do
        case "$key" in
            '') continue ;;
            Port) number Port "$value" 1 65535 ;;
            PasswordAuthentication|PubkeyAuthentication|X11Forwarding) yesno "$key" "$value" ;;
            PermitRootLogin)
                case "$value" in no|prohibit-password|yes) ;; *) die "PermitRootLogin: no, prohibit-password or yes";; esac ;;
            AllowUsers)
                case "$value" in *[!A-Za-z0-9._@*?\ -]*) die "AllowUsers: user names separated by spaces";; esac
                [ -n "$value" ] || continue ;;
            *) die "Unknown SSH setting: $key" ;;
        esac
        out="$out$key $value
"
    done
    conf=/etc/ssh/sshd_config.d/50-wayland95.conf
    mkdir -p /etc/ssh/sshd_config.d /run/sshd
    backup=""
    if [ -e "$conf" ]; then
        backup=$(mktemp "$conf.old.XXXXXX")
        cp -p "$conf" "$backup"
    fi
    printf '%s' "$out" | put "$conf"
    if ! check=$(sshd -t 2>&1); then
        if [ -n "$backup" ]; then mv -f "$backup" "$conf"; else rm -f "$conf"; fi
        die "SSH didn't accept these settings: $check"
    fi
    [ -z "$backup" ] || rm -f "$backup"
    if systemctl is-active -q ssh.socket 2>/dev/null; then
        # the socket's port comes from sshd_config (a generator)
        systemctl daemon-reload
        systemctl restart ssh.socket
    elif systemctl is-active -q ssh.service 2>/dev/null; then
        systemctl reload-or-restart ssh.service
    fi
    ;;

pg-config)
    listen=localhost port="" max="" remote=no
    while IFS='=' read -r key value; do
        case "$key" in
            '') continue ;;
            listen) case "$value" in localhost|all) listen=$value ;; *) die "listen: localhost or all";; esac ;;
            port) number port "$value" 1 65535; port=$value ;;
            max_connections) number max_connections "$value" 1 10000; max=$value ;;
            remote) yesno remote "$value"; remote=$value ;;
            *) die "Unknown PostgreSQL setting: $key" ;;
        esac
    done
    cluster=$(pg_cluster)
    set -- $cluster
    dir=/etc/postgresql/$1/$2
    [ -d "$dir" ] || die "No configuration folder for PostgreSQL $1 ($dir)."
    mkdir -p "$dir/conf.d"
    {
        echo "# Written by the Wayland 95 Services control panel; changes here are overwritten."
        echo "# wayland95: remote=$remote"
        if [ "$listen" = all ]; then echo "listen_addresses = '*'"; else echo "listen_addresses = 'localhost'"; fi
        [ -z "$port" ] || echo "port = $port"
        [ -z "$max" ] || echo "max_connections = $max"
    } | put "$dir/conf.d/50-wayland95.conf"
    # other computers may log on with a password (pg_hba.conf)
    hba=$dir/pg_hba.conf
    if [ -f "$hba" ]; then
        tmp=$(mktemp "$hba.XXXXXX")
        sed '/^# BEGIN wayland95$/,/^# END wayland95$/d' "$hba" >"$tmp"
        if [ "$remote" = yes ]; then
            printf '%s\n' "# BEGIN wayland95" \
                "host    all             all             0.0.0.0/0               scram-sha-256" \
                "host    all             all             ::/0                    scram-sha-256" \
                "# END wayland95" >>"$tmp"
        fi
        chown --reference="$hba" "$tmp"
        chmod --reference="$hba" "$tmp"
        mv -f "$tmp" "$hba"
    fi
    systemctl restart postgresql.service
    ;;

pg-role)
    [ $# -ge 1 ] || die "usage: pg-role NAME [superuser]"
    name=$1
    case "$name" in ''|-*|*[!A-Za-z0-9._-]*) die "Not a usable account name: $name";; esac
    [ ${#name} -le 63 ] || die "The name is too long."
    super=no
    [ "${2:-}" = superuser ] && super=yes
    cluster=$(pg_cluster)
    set -- $cluster
    runuser -u postgres -- psql -X -q -p "$3" -d postgres -v ON_ERROR_STOP=1 -v role="$name" -v super="$super" <<'SQL'
SELECT format('CREATE ROLE %I LOGIN CREATEDB', :'role')
 WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'role') \gexec
SELECT format('ALTER ROLE %I SUPERUSER', :'role') WHERE :'super' = 'yes' \gexec
SELECT format('CREATE DATABASE %I OWNER %I', :'role', :'role')
 WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'role') \gexec
SQL
    ;;

my-config)
    my_installed
    listen=localhost port="" max=""
    while IFS='=' read -r key value; do
        case "$key" in
            '') continue ;;
            listen) case "$value" in localhost|all) listen=$value ;; *) die "listen: localhost or all";; esac ;;
            port) number port "$value" 1 65535; port=$value ;;
            max_connections) number max_connections "$value" 1 100000; max=$value ;;
            *) die "Unknown MySQL setting: $key" ;;
        esac
    done
    # last in name order, so these win over the package's 50-server.cnf
    dir=/etc/mysql/mariadb.conf.d
    conf=$dir/99-wayland95.cnf
    mkdir -p "$dir"
    backup=""
    if [ -e "$conf" ]; then
        backup=$(mktemp "$conf.old.XXXXXX")
        cp -p "$conf" "$backup"
    fi
    {
        echo "# Written by the Wayland 95 Services control panel; changes here are overwritten."
        echo "[mysqld]"
        if [ "$listen" = all ]; then echo "bind-address = 0.0.0.0"; else echo "bind-address = 127.0.0.1"; fi
        [ -z "$port" ] || echo "port = $port"
        [ -z "$max" ] || echo "max_connections = $max"
    } | put "$conf"
    if systemctl is-active -q mariadb.service 2>/dev/null; then
        if ! systemctl restart mariadb.service; then
            if [ -n "$backup" ]; then mv -f "$backup" "$conf"; else rm -f "$conf"; fi
            systemctl restart mariadb.service || true
            die "MySQL didn't start with these settings, so they were put back. $(systemctl status mariadb.service 2>&1 | tail -n 3 | tr '\n' ' ')"
        fi
    fi
    [ -z "$backup" ] || rm -f "$backup"
    ;;

my-role)
    [ $# -ge 1 ] || die "usage: my-role NAME [admin]"
    my_installed
    my_name "$1"
    admin=no
    [ "${2:-}" = admin ] && admin=yes
    {
        echo "CREATE USER IF NOT EXISTS '$1'@'localhost' IDENTIFIED VIA unix_socket;"
        my_grants "$1" localhost "$admin"
        echo "CREATE DATABASE IF NOT EXISTS \`$1\`;"
    } | my_sql || die "MySQL didn't make the account (is it running?)."
    ;;

my-password)
    [ $# -eq 1 ] || die "usage: my-password NAME"
    my_installed
    my_name "$1"
    pw=""
    IFS= read -r pw || true
    [ ${#pw} -le 200 ] || die "The password is too long."
    there=$(echo "SELECT COUNT(*) FROM mysql.user WHERE User = '$1' AND Host = 'localhost';" | my_sql) \
        || die "MySQL didn't answer (is it running?)."
    [ "$there" = 1 ] || die "Make your MySQL account first."
    if [ -z "$pw" ]; then
        echo "DROP USER IF EXISTS '$1'@'%';" | my_sql || die "MySQL didn't take that."
        exit 0
    fi
    admin=$(echo "SELECT COUNT(*) FROM information_schema.USER_PRIVILEGES WHERE GRANTEE = '''$1''@''localhost''' AND PRIVILEGE_TYPE = 'CREATE USER';" | my_sql)
    if [ "$admin" = 0 ]; then admin=no; else admin=yes; fi
    # the password goes in as hex, quoted by the server itself (QUOTE):
    # nothing in it can end the statement; and it's never an argument
    hex=$(printf '%s' "$pw" | od -An -v -tx1 | tr -d ' \n')
    {
        echo "SET @pw = CONVERT(0x$hex USING utf8mb4);"
        echo "SET @s = CONCAT('CREATE OR REPLACE USER ''$1''@''%'' IDENTIFIED BY ', QUOTE(@pw));"
        echo "PREPARE s FROM @s; EXECUTE s; DEALLOCATE PREPARE s; SET @pw = NULL, @s = NULL;"
        my_grants "$1" % "$admin"
    } | my_sql || die "MySQL didn't take the password."
    ;;

nginx-config)
    # who asked (pkexec says): a website folder may be in their home
    uid=${PKEXEC_UID:-}
    case "$uid" in ''|*[!0-9]*) die "Run this through pkexec." ;; esac
    home=$(getent passwd "$uid" | cut -d: -f6)
    [ -n "$home" ] && [ "$home" != / ] || die "No home folder for user $uid."
    command -v nginx >/dev/null && [ -d /etc/nginx ] || die "nginx isn't installed."
    listen=all port=80 root=/var/www/html autoindex=no
    while IFS='=' read -r key value; do
        case "$key" in
            '') continue ;;
            listen) case "$value" in localhost|all) listen=$value ;; *) die "listen: localhost or all";; esac ;;
            port) number port "$value" 1 65535; port=$value ;;
            root) root=$value ;;
            autoindex) yesno autoindex "$value"; autoindex=$value ;;
            *) die "Unknown nginx setting: $key" ;;
        esac
    done
    # the folder: a real one, by its own name, where websites belong
    case "$root" in
        /*) ;; *) die "The website's folder must be a full path." ;;
    esac
    case "$root" in *[\"\$\\\;\{\}\'\`]*|*'
'*) die "The website's folder can't have \" \$ \\ ; { } ' or \` in its name." ;; esac
    [ -d "$root" ] || die "There's no folder $root."
    real=$(realpath -e -- "$root") || die "There's no folder $root."
    [ "$real" = "${root%/}" ] || die "Give the folder by its own name, not a link ($root is $real)."
    root=$real
    case "/$root/" in */.*) die "A hidden folder can't be the website." ;; esac
    inhome=no
    case "$root" in
        /var/www|/var/www/*|/srv|/srv/*) ;;
        "$home") die "Your whole home folder can't be the website: choose a folder in it." ;;
        "$home"/*) inhome=yes ;;
        *) die "The website's folder must be in /var/www, /srv or your home folder." ;;
    esac
    conf=/etc/nginx/sites-available/wayland95
    link=/etc/nginx/sites-enabled/wayland95
    old_root=""
    [ -f "$conf" ] && old_root=$(sed -n 's/^# wayland95: .*\troot=\([^\t]*\).*/\1/p' "$conf" | head -n 1)
    mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
    backup=""
    if [ -e "$conf" ]; then
        backup=$(mktemp "$conf.old.XXXXXX")
        cp -p "$conf" "$backup"
    fi
    default_was=no
    [ -L /etc/nginx/sites-enabled/default ] && default_was=yes
    {
        printf '# wayland95: listen=%s\tport=%s\troot=%s\tautoindex=%s\n' "$listen" "$port" "$root" "$autoindex"
        echo "# Written by the Wayland 95 Services control panel; changes here are overwritten."
        echo "server {"
        if [ "$listen" = all ]; then
            echo "    listen $port default_server;"
            echo "    listen [::]:$port default_server;"
        else
            echo "    listen 127.0.0.1:$port default_server;"
            echo "    listen [::1]:$port default_server;"
        fi
        echo "    server_name _;"
        echo "    root \"$root\";"
        echo "    index index.html index.htm;"
        echo "    autoindex $( [ "$autoindex" = yes ] && echo on || echo off );"
        echo "    # (no following links to files their owner doesn't own)"
        echo "    disable_symlinks if_not_owner;"
        echo "    location ~ /\\. { deny all; }"
        echo "    location / { try_files \$uri \$uri/ =404; }"
        echo "}"
    } | put "$conf"
    ln -sfn ../sites-available/wayland95 "$link"
    # (Debian's own site would be in the way)
    rm -f /etc/nginx/sites-enabled/default
    restore() {
        if [ -n "$backup" ]; then mv -f "$backup" "$conf"; else rm -f "$conf" "$link"; fi
        [ "$default_was" = no ] || ln -sfn ../sites-available/default /etc/nginx/sites-enabled/default
    }
    if ! check=$(nginx -t 2>&1); then
        restore
        die "nginx didn't accept these settings: $check"
    fi
    if systemctl is-active -q nginx.service 2>/dev/null; then
        if ! systemctl reload-or-restart nginx.service; then
            restore
            systemctl restart nginx.service || true
            die "nginx didn't start with these settings, so they were put back."
        fi
    fi
    [ -z "$backup" ] || rm -f "$backup"
    # a folder in your home: nginx (www-data) may go through the folders on
    # the way, and read this one (and what's put in it later), nothing else
    if [ "$inhome" = yes ]; then
        command -v setfacl >/dev/null || die "Settings saved, but nginx can't read your folder: install acl (setfacl)."
        d=$(dirname "$root")
        while :; do
            setfacl -m u:www-data:x "$d"
            [ "$d" = "$home" ] && break
            d=$(dirname "$d")
        done
        setfacl -R -m u:www-data:rX "$root"
        setfacl -R -d -m u:www-data:rX "$root"
    fi
    # the folder before, if it was one of yours: nginx can't read it now
    if [ -n "$old_root" ] && [ "$old_root" != "$root" ] && [ -d "$old_root" ]; then
        case "$old_root" in
            "$home"/*) command -v setfacl >/dev/null && setfacl -R -x u:www-data "$old_root" 2>/dev/null \
                           && setfacl -R -d -x u:www-data "$old_root" 2>/dev/null || true ;;
        esac
    fi
    ;;

www-own)
    # /var/www/html becomes the user's (pkexec's caller), so they can edit it
    uid=${PKEXEC_UID:-}
    case "$uid" in ''|*[!0-9]*) die "Run this through pkexec." ;; esac
    [ "$uid" != 0 ] || die "It's root's already."
    gid=$(getent passwd "$uid" | cut -d: -f4)
    [ -n "$gid" ] || die "No such user: $uid."
    [ -d /var/www/html ] && [ ! -L /var/www/html ] || die "There's no /var/www/html."
    chown -R --no-dereference "$uid:$gid" /var/www/html
    chmod u+rwX,go+rX -R /var/www/html
    ;;

wg-list)
    for n in $(wg_names); do
        e=no a=no
        systemctl is-enabled -q "wg-quick@$n.service" 2>/dev/null && e=yes
        [ -d "/sys/class/net/$n" ] && a=yes
        echo "$n $e $a"
    done
    ;;

wg-show)
    [ $# -eq 1 ] || die "usage: wg-show NAME"
    wg_name "$1"
    conf=/etc/wireguard/$1.conf
    [ -f "$conf" ] || die "There's no tunnel called $1."
    e=no a=no
    systemctl is-enabled -q "wg-quick@$1.service" 2>/dev/null && e=yes
    [ -d "/sys/class/net/$1" ] && a=yes
    # what each peer is doing now: its key, endpoint, last handshake, bytes
    live=""
    [ "$a" = yes ] && live=$(wg show "$1" dump 2>/dev/null | tail -n +2 | awk '{ print $1, $3, $5, $6, $7 }')
    wg_parse "$conf" | while IFS= read -r line; do
        case "$line" in
            '[interface]') printf '[interface]\nname=%s\nenabled=%s\nactive=%s\n' "$1" "$e" "$a" ;;
            PrivateKey=*) printf 'PublicKey=%s\n' "$(printf '%s' "${line#PrivateKey=}" | wg pubkey 2>/dev/null)" ;;
            PresharedKey=*) echo "PresharedKey=yes" ;;
            other=*) echo "$line" ;;
            PublicKey=*)
                echo "$line"
                printf '%s\n' "$live" | awk -v k="${line#PublicKey=}" '$1 == k { print "endpointNow=" $2; print "handshake=" $3; print "rx=" $4; print "tx=" $5 }' ;;
            *) echo "$line" ;;
        esac
    done
    ;;

wg-save)
    [ $# -eq 1 ] || die "usage: wg-save NAME"
    wg_name "$1"
    command -v wg-quick >/dev/null || die "WireGuard isn't installed."
    wg_write "$1" save
    ;;

wg-import)
    [ $# -eq 1 ] || die "usage: wg-import NAME"
    wg_name "$1"
    command -v wg-quick >/dev/null || die "WireGuard isn't installed."
    [ ! -e "/etc/wireguard/$1.conf" ] || die "There's already a tunnel called $1."
    text=$(cat)
    left=$(printf '%s\n' "$text" | wg_parse - | sed -n 's/^other=\([A-Za-z]*\).*/\1/p' | sort -u | tr '\n' ' ')
    printf '%s\n' "$text" | wg_parse - | wg_write "$1" import
    [ -z "$left" ] || echo "Left out of the file (add them by hand if you need them): $left"
    ;;

wg-delete)
    [ $# -eq 1 ] || die "usage: wg-delete NAME"
    wg_name "$1"
    [ -f "/etc/wireguard/$1.conf" ] || die "There's no tunnel called $1."
    systemctl disable --now "wg-quick@$1.service" 2>/dev/null || true
    rm -f "/etc/wireguard/$1.conf"
    ;;
smb-config)
    # Samba's workgroup and description, and the caller's shared folders
    # (all of them: the ones not given stop being shared). Other people's
    # shares are kept as they are. Each share acts as its owner (force
    # user), so it only gives what the owner could reach anyway.
    smb_caller
    smb_installed
    tab=$(printf '\t')
    workgroup="" description="" wg_given=no desc_given=no
    if [ -f "$SMB_OURS" ]; then
        workgroup=$(sed -n '/^\[global\]/,/^\[/s/^[[:space:]]*workgroup[[:space:]]*=[[:space:]]*//p' "$SMB_OURS" | head -n 1)
        description=$(sed -n '/^\[global\]/,/^\[/s/^[[:space:]]*server string[[:space:]]*=[[:space:]]*//p' "$SMB_OURS" | head -n 1)
        others=$(awk -v me="$user" '
            function flush() { if (name != "" && tolower(name) != "global" && owner != me) printf "%s", buf; buf = ""; name = ""; owner = "" }
            /^[ \t]*\[.*\][ \t]*$/ { flush(); name = $0; gsub(/^[ \t]*\[|\][ \t]*$/, "", name) }
            /^[ \t]*# wayland95: owner=/ { owner = $0; sub(/^[ \t]*# wayland95: owner=/, "", owner) }
            name != "" { buf = buf $0 "\n" }
            END { flush() }' "$SMB_OURS")
    else
        others=""
    fi
    # names in use: smb.conf's own shares (printers...) and everyone else's
    taken=$( { sed -n 's/^[[:space:]]*\[\(.*\)\][[:space:]]*$/\1/p' "$SMB_CONF"
               printf '%s\n' "$others" | sed -n 's/^\[\(.*\)\]$/\1/p'; } | tr 'A-Z' 'a-z')
    names="" shares="" count=0
    while IFS='=' read -r key value; do
        case "$key" in
            '') continue ;;
            workgroup)
                case "$value" in ''|[.-]*|*[!A-Za-z0-9_.-]*) die "A workgroup's name has letters, digits, - _ and . in it." ;; esac
                [ ${#value} -le 15 ] || die "A workgroup's name can have 15 characters at most."
                workgroup=$value wg_given=yes ;;
            description)
                smb_text "The description" "$value"
                description=$value desc_given=yes ;;
            share)
                # NAME <tab> FOLDER <tab> read|full <tab> me|anyone <tab> COMMENT
                IFS=$tab read -r name path access who comment <<EOF
$value
EOF
                count=$((count + 1))
                [ "$count" -le 200 ] || die "That's too many shared folders."
                case "$name" in ''|[\ .]*|*\ ) die "Not a usable share name: \"$name\"" ;; esac
                case "$name" in *[!A-Za-z0-9\ _.-]*) die "A share's name can have letters, digits, spaces, - _ and . in it (not \"$name\")." ;; esac
                [ ${#name} -le 80 ] || die "A share's name can have 80 characters at most."
                low=$(smb_lower "$name")
                case "$low" in global|homes|printers) die "\"$name\" is one of Samba's own names." ;; esac
                if printf '%s\n' "$taken" "$names" | grep -qxF -- "$low"; then
                    die "There's already a shared folder called \"$name\"."
                fi
                names="$names
$low"
                case "$access" in read|full) ;; *) die "access: read or full" ;; esac
                case "$who" in me|anyone) ;; *) die "who: me or anyone" ;; esac
                smb_text "A shared folder's comment" "$comment"
                # the folder: a real one of the caller's, by its own name
                case "$path" in /?*) ;; *) die "A shared folder must be given by its full path." ;; esac
                case "$path" in *[[:cntrl:]\"\\%]*|*\ ) die "A shared folder's name can't have \" \\ or % in it, or end in a space." ;; esac
                [ -d "$path" ] || die "There's no folder $path."
                real=$(realpath -e -- "$path") || die "There's no folder $path."
                [ "$real" = "${path%/}" ] || die "Give the folder by its own name, not a link ($path is $real)."
                case "$real/" in */.*) die "A hidden folder can't be shared ($real)." ;; esac
                [ "$real" != "$home" ] || die "Your whole home folder can't be shared: choose a folder in it."
                [ "$(stat -c %u -- "$real")" = "$uid" ] || die "$real isn't yours, so you can't share it."
                ro=no; [ "$access" = read ] && ro=yes
                section="[$name]
   # wayland95: owner=$user
   path = $real
   comment = $comment
   read only = $ro
   force user = $user
   # (files starting with a dot are never shown nor made)
   veto files = /.*/
   delete veto files = no"
                if [ "$who" = anyone ]; then
                    section="$section
   guest ok = yes"
                else
                    section="$section
   guest ok = no
   valid users = $user"
                fi
                shares="$shares$section

" ;;
            *) die "Unknown Samba setting: $key" ;;
        esac
    done
    backup_ours=""
    if [ -e "$SMB_OURS" ]; then
        backup_ours=$(mktemp "$SMB_OURS.old.XXXXXX")
        cp -p "$SMB_OURS" "$backup_ours"
    fi
    backup_conf=$(mktemp "$SMB_CONF.old.XXXXXX")
    cp -p "$SMB_CONF" "$backup_conf"
    {
        echo "# Written by the Wayland 95 Services control panel; changes here are overwritten."
        echo "# smb.conf includes this at its end, so these settings win over its own."
        echo "[global]"
        [ -z "$workgroup" ] || echo "   workgroup = $workgroup"
        [ -z "$description" ] || echo "   server string = $description"
        echo "   map to guest = bad user"
        echo
        [ -z "$others" ] || printf '%s\n' "$others"
        printf '%s' "$shares"
    } | put "$SMB_OURS"
    if ! sed 's/[[:space:]]//g' "$SMB_CONF" | grep -qxF "include=$SMB_OURS"; then
        printf '\n%s\n%s\n%s\n' "# Wayland 95: the Services control panel's Samba settings and shared folders" \
            "[global]" "   include = $SMB_OURS" >>"$SMB_CONF"
    fi
    smb_restore() {
        if [ -n "$backup_ours" ]; then mv -f "$backup_ours" "$SMB_OURS"; else rm -f "$SMB_OURS"; fi
        mv -f "$backup_conf" "$SMB_CONF"
    }
    if command -v testparm >/dev/null && ! check=$(testparm -s "$SMB_CONF" 2>&1 >/dev/null); then
        smb_restore
        die "Samba didn't accept these settings: $(echo "$check" | grep -v '^Load smb\|^$' | tail -n 3 | tr '\n' ' ')"
    fi
    [ -z "$backup_ours" ] || rm -f "$backup_ours"
    rm -f "$backup_conf"
    # (what's connected carries on; new and changed shares show at once)
    if systemctl is-active -q smbd.service 2>/dev/null; then
        systemctl reload smbd.service || systemctl restart smbd.service || true
    fi
    if [ "$wg_given$desc_given" != nono ] && systemctl is-active -q nmbd.service 2>/dev/null; then
        systemctl restart nmbd.service || true
    fi
    ;;

smb-password)
    # the caller's Samba password (on stdin), for shares that need one;
    # none: it's taken away
    smb_caller
    command -v smbpasswd >/dev/null || die "Samba isn't installed."
    pw=""
    IFS= read -r pw || true
    [ ${#pw} -le 200 ] || die "The password is too long."
    if [ -z "$pw" ]; then
        smbpasswd -x "$user" >/dev/null 2>&1 || true
        exit 0
    fi
    # (on stdin, twice, as smbpasswd -s wants it: never an argument)
    printf '%s\n%s\n' "$pw" "$pw" | smbpasswd -a -s "$user" >/dev/null || die "Samba didn't take the password."
    smbpasswd -e "$user" >/dev/null || true
    ;;

update-source)
    # installs made before the repository existed lack it (the wayland95
    # package adds this same file once it's there)
    [ -f /usr/share/keyrings/wayland95-archive-keyring.gpg ] || die "Wayland 95's signing key is missing (/usr/share/keyrings/wayland95-archive-keyring.gpg)."
    printf '%s\n' \
        "# Wayland 95's updates (the wayland95 package): installed by it, so apt," \
        "# Add/Remove Programs > Updates and the update notice find new versions." \
        "Types: deb" \
        "URIs: https://pacificnm.github.io/wayland95" \
        "Suites: stable" \
        "Components: main" \
        "Signed-By: /usr/share/keyrings/wayland95-archive-keyring.gpg" | put /etc/apt/sources.list.d/wayland95.sources
    ;;

login-theme)
    # SDDM reads /etc/sddm.conf.d/*.conf in name order, so this one wins over
    # the ones before it (KDE's kde_settings.conf); /etc/sddm.conf still
    # wins over all of them (Control Panel says so when it does)
    [ $# -eq 1 ] || die "usage: login-theme wayland95|default"
    conf=/etc/sddm.conf.d/wayland95.conf
    case "$1" in
    wayland95)
        [ -f /usr/share/sddm/themes/wayland95/Main.qml ] \
            || die "Wayland 95's login screen isn't installed (/usr/share/sddm/themes/wayland95)."
        mkdir -p /etc/sddm.conf.d
        printf '%s\n' \
            "# The login screen: Wayland 95's own theme (/usr/share/sddm/themes/wayland95)." \
            "# Control Panel > Passwords > Log On writes this file, and deletes it to go back." \
            "[Theme]" \
            "Current=wayland95" | put "$conf"
        ;;
    default)
        rm -f "$conf"
        ;;
    *)
        die "login-theme: wayland95 or default"
        ;;
    esac
    ;;

*)
    die "usage: wayland95-services unit|ssh-config|pg-config|pg-role|my-config|my-role|my-password|nginx-config|www-own|smb-config|smb-password|wg-list|wg-show|wg-save|wg-import|wg-delete|update-source|login-theme ..."
    ;;
esac
